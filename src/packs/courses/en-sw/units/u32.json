    "tips": [
      {
        "id": "reciprocal",
        "title": "Each other: -ana",
        "body": [
          "Replace the last **-a** with **-ana** and the action goes both ways: **-penda** (love) → **-pendana** (love each other), **-saidia** → **-saidiana** (help each other), **-ona** → **-onana** (see each other).",
          "You’ve known one since Unit 1: **Tutaonana**, “we will see each other”."
        ]
      }
    ],
    "culture": [
      {
        "title": "Harambee",
        "body": [
          "**Harambee** (“let’s all pull together”) is Kenya’s national motto. A harambee is a community fundraiser for a school, a hospital bill or a student’s fees, where everyone gives what they can."
        ]
      }
    ]
  },
  "stories": [
    {
      "id": "sw-harambee",
      "title": "The harambee",
      "unlockAfter": "u32s2l1",
      "cast": ["amani", "neema"],
      "summary": "Amani and Neema go to a harambee for a neighbour’s school fees.",
      "steps": [
        {
          "line": { "speaker": "neema", "target": "Amani, kwa nini kuna watu wengi hapa?", "base": "Amani, why are there so many people here?" }
        },
        {
          "line": {
            "speaker": "amani",
            "target": "Ni harambee. Mtoto wa jirani amepata nafasi chuo kikuu.",
            "base": "It’s a harambee. The neighbour’s child has got a place at university."
          },
          "gloss": { "nafasi": "place, chance", "chuo kikuu": "university" }
        },
        {
          "question": "What is the harambee for?",
          "options": ["A neighbour’s child’s university place", "A wedding", "A new road"],
          "answer": 0
        },
        {
          "line": { "speaker": "neema", "target": "Vizuri! Mimi nitatoa shilingi elfu mbili.", "base": "Great! I’ll give two thousand shillings." },
          "gloss": { "nitatoa": "I will give" }
        },
        {
          "line": { "speaker": "amani", "target": "Asante. Kidole kimoja hakivunji chawa.", "base": "Thank you. One finger can’t crush a louse." },
          "gloss": { "Kidole kimoja hakivunji chawa": "a proverb: we need each other to succeed" }
        },
        {
          "question": "What does Amani’s proverb mean?",
          "options": ["We need each other", "Fingers are small", "Wash your hands"],
          "answer": 0
        },
        { "line": { "speaker": "neema", "target": "Kweli. Tusaidiane!", "base": "True. Let’s help each other!" } },
        {
          "question": "How does Neema say “let’s help each other”?",
          "options": ["Tusaidiane", "Tunapendana", "Harambee"],
          "answer": 0,
          "optionsLang": "target"
        }
      ]
    }
  ]
