      "summary": "Neema brings Emma to Bibi’s house for Eid.",
      "steps": [
        { "line": { "speaker": "neema", "target": "Bibi, Idi mubarak! Huyu ni Emma.", "base": "Grandma, Eid Mubarak! This is Emma." } },
