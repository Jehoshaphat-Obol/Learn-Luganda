        {
          "line": { "speaker": "emma", "target": "Asante, bibi. Hii ni zawadi yako.", "base": "Thank you, Grandma. This is a gift for you." }
        },
        { "question": "What does Emma bring?", "options": ["A gift", "A cake", "A kanga"], "answer": 0 },
        {
          "line": {
            "speaker": "bibi",
            "target": "Ah, tende! Asante sana. Wageni wote waliokuja leo wanataka pilau!",
            "base": "Ah, dates! Thank you very much. All the guests who came today want pilau!"
          },
          "gloss": { "tende": "dates (fruit)", "wote": "all" }
        },
        { "question": "What did Emma give Bibi?", "options": ["Dates", "Cloves", "Tea"], "answer": 0 },
        {
          "line": { "speaker": "neema", "target": "Na mimi nitawaletea chai.", "base": "And I’ll bring them tea." },
          "gloss": { "nitawaletea": "I will bring (to them)" }
        },
        {
          "line": {
            "speaker": "bibi",
            "target": "Vizuri. Mgeni aje, mwenyeji apone.",
            "base": "Good. Let the guest come, so the host may prosper."
