        { "question": "Who is hurt?", "options": ["The boda boda rider", "Emma", "A child"], "answer": 0 },
        {
          "line": { "speaker": "emma", "target": "Anatoka damu! Nipigie gari la wagonjwa?", "base": "He’s bleeding! Shall I call an ambulance?" }
        },
        {
          "line": { "speaker": "juma", "target": "Ndiyo, piga simu haraka. Mimi nitakaa naye.", "base": "Yes, call quickly. I’ll stay with him." },
          "gloss": { "naye": "with him" }
        },
