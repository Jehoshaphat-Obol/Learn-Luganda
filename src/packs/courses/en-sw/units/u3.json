  "guidebook": {
    "intro": "Food is how East Africa says welcome. Expect to be offered chai the moment you sit down, and expect to bargain, cheerfully, at the market.",
    "phrases": [
      { "target": "Nataka chai.", "base": "I want tea." },
      { "target": "Nina njaa.", "base": "I am hungry." },
      { "target": "Nina kiu.", "base": "I am thirsty." },
      { "target": "Chakula ni kitamu sana!", "base": "The food is very tasty!" },
      { "target": "Bei gani?", "base": "How much?" },
      { "target": "Ni ghali sana!", "base": "It’s very expensive!" },
      { "target": "Punguza bei, tafadhali.", "base": "Lower the price, please." },
      { "target": "Nipe ndizi tano.", "base": "Give me five bananas." }
    ],
    "tips": [
      {
        "id": "hungry-thirsty",
        "title": "You have hunger",
        "body": [
          "Swahili says you **have** hunger and thirst: **Nina njaa** (I am hungry), **Nina kiu** (I am thirsty). To ask, swap to **una**: **Una njaa?**"
        ]
      },
      {
        "id": "ki-vi",
        "title": "Things: ki- and vi-",
        "body": [
          "Many words for things start with **ki-** for one and **vi-** for more: **kitu**, **vitu** (thing, things); **chakula** is one of them (**ch-** before a vowel).",
          "Describing words follow: **chakula kitamu** (tasty food). Fruit and many other foods are in a different class, so you say **embe tamu** (a sweet mango)."
        ]
      },
      {
        "id": "bargaining",
        "title": "Bargaining is a conversation",
        "body": [
          "Ask **Bei gani?** (how much?), react with **Ni ghali!** (it’s expensive!), and suggest **Punguza bei** (lower the price). Smile, greet the seller first, and settle somewhere in the middle."
        ]
      }
    ],
    "culture": [
      {
        "title": "Ugali, posho, sima",
        "body": [
          "Stiff maize porridge is the staple across the region: **ugali** in Kenya and Tanzania, **posho** in Uganda. It is eaten with the right hand, rolled into a ball and dipped in stew."
        ]
      },
      {
        "title": "Tafadhali",
        "body": [
          "**Tafadhali** means please. You’ll hear it with requests: **Nipe maji, tafadhali** (give me water, please)."
        ]
      }
    ]
  },
  "stories": [
    {
      "id": "sw-chai-stall",
      "title": "Chai at Baraka’s",
      "unlockAfter": "u3s2l3",
      "cast": ["baraka", "emma"],
      "summary": "Emma has breakfast at Baraka’s stall in Mombasa.",
      "steps": [
        { "line": { "speaker": "baraka", "target": "Karibu, Emma! Habari za asubuhi?", "base": "Welcome, Emma! Good morning?" } },
        { "line": { "speaker": "emma", "target": "Nzuri, Baraka. Nina njaa sana!", "base": "Fine, Baraka. I am very hungry!" } },
        { "question": "How is Emma feeling?", "options": ["Thirsty", "Very hungry", "Tired"], "answer": 1 },
        { "line": { "speaker": "baraka", "target": "Unataka chapati na chai?", "base": "Do you want chapati and tea?" }, "gloss": { "Unataka": "you want, do you want" } },
        { "line": { "speaker": "emma", "target": "Ndiyo! Chai na maziwa na sukari, tafadhali.", "base": "Yes! Tea with milk and sugar, please." } },
        { "question": "What does Emma put in her tea?", "options": ["Milk and sugar", "Nothing", "Coffee"], "answer": 0 },
        { "line": { "speaker": "emma", "target": "Chakula ni kitamu sana!", "base": "The food is very tasty!" } },
        { "question": "How does Emma say the food is tasty?", "options": ["Ni ghali", "Ni kitamu", "Ni rahisi"], "answer": 1, "optionsLang": "target" },
        { "line": { "speaker": "baraka", "target": "Asante! Karibu tena.", "base": "Thank you! Come again." }, "gloss": { "tena": "again" } }
      ]
    },
    {
      "id": "sw-mango-deal",
      "title": "A good price for mangoes",
      "unlockAfter": "u3s3l3",
      "cast": ["amani", "juma"],
      "summary": "Amani bargains for mangoes at Kariakoo market, with Juma’s help.",
      "steps": [
        { "line": { "speaker": "amani", "target": "Embe ni bei gani?", "base": "How much is a mango?" } },
        { "line": { "speaker": "juma", "target": "Shilingi mia moja.", "base": "One hundred shillings." }, "gloss": { "mia moja": "one hundred" } },
        { "line": { "speaker": "amani", "target": "Ni ghali sana! Punguza bei, tafadhali.", "base": "That’s very expensive! Lower the price, please." } },
        { "question": "What does Amani think of the price?", "options": ["It’s cheap", "It’s expensive", "It’s fair"], "answer": 1 },
        { "line": { "speaker": "juma", "target": "Haya, shilingi themanini.", "base": "Okay, eighty shillings." }, "gloss": { "themanini": "eighty" } },
        { "line": { "speaker": "amani", "target": "Sawa. Nipe maembe matano.", "base": "Fine. Give me five mangoes." }, "gloss": { "Sawa": "fine, okay", "maembe matano": "five mangoes" } },
        { "question": "How many mangoes does Amani buy?", "options": ["Three", "Five", "Ten"], "answer": 1 },
        { "line": { "speaker": "juma", "target": "Asante sana! Maembe ni matamu.", "base": "Thank you very much! The mangoes are sweet." } },
        { "question": "Which word did Amani use to ask for a lower price?", "options": ["Nipe", "Punguza", "Karibu"], "answer": 1, "optionsLang": "target" }
      ]
    }
