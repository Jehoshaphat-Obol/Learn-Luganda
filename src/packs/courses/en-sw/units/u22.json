  "guidebook": {
    "intro": "Football, music and board games fill evenings and weekends across East Africa. Learn to talk about what you enjoy.",
    "phrases": [
      { "target": "Unapenda kufanya nini?", "base": "What do you like doing?" },
      { "target": "Ninapenda kuimba.", "base": "I like singing." },
