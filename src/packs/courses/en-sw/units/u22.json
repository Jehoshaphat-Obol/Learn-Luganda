      "title": "The big match",
      "unlockAfter": "u22s2l2",
      "cast": ["baraka", "juma"],
      "summary": "Juma and Baraka watch a football match on the TV at Baraka’s stall.",
      "steps": [
        {
          "line": { "speaker": "baraka", "target": "Juma, karibu! Mchezo umeanza.", "base": "Juma, welcome! The game has started." },
          "gloss": { "umeanza": "has started" }
        },
        { "line": { "speaker": "juma", "target": "Timu yangu itashinda leo!", "base": "My team will win today!" } },
        {
          "line": { "speaker": "baraka", "target": "Hapana! Timu yangu ni hodari zaidi.", "base": "No way! My team is better." },
          "gloss": { "zaidi": "more" }
        },
        { "question": "What does Juma think?", "options": ["His team will win", "His team will lose", "He has no team"], "answer": 0 },
        {
          "line": { "speaker": "juma", "target": "Goli! Goli! Tumefunga!", "base": "Goal! Goal! We’ve scored!" },
          "gloss": { "Tumefunga": "we have scored" }
        },
        { "question": "What happened?", "options": ["Juma’s team scored", "Baraka’s team scored", "The TV broke"], "answer": 0 },
        {
          "line": { "speaker": "baraka", "target": "Aah! Usijali, mchezo bado haujaisha.", "base": "Ah! Never mind, the game isn’t over yet." },
          "gloss": { "haujaisha": "it hasn’t ended" }
        },
        {
          "line": { "speaker": "juma", "target": "Sawa, lakini kama tutashinda, chai ni bure!", "base": "Okay, but if we win, the tea is free!" },
          "gloss": { "kama": "if", "bure": "free" }
        },
        { "question": "How does Juma shout “goal”?", "options": ["Goli!", "Timu!", "Mpira!"], "answer": 0, "optionsLang": "target" }
      ]
