        {
          "line": { "speaker": "neema", "target": "Unatoka wapi, na una miaka mingapi?", "base": "Where are you from, and how old are you?" }
        },
        {
          "line": { "speaker": "emma", "target": "Ninatoka Kanada. Nina miaka ishirini na nne.", "base": "I come from Canada. I’m twenty-four." }
        },
        { "question": "How old is Emma?", "options": ["24", "20", "42"], "answer": 0 },
        { "line": { "speaker": "neema", "target": "Kwa nini unajifunza Kiswahili?", "base": "Why are you learning Swahili?" } },
        {
          "line": {
            "speaker": "emma",
            "target": "Kwa sababu ninapenda Afrika Mashariki, na marafiki zangu wanaongea Kiswahili.",
            "base": "Because I love East Africa, and my friends speak Swahili."
          },
          "gloss": { "zangu": "my (with many n- nouns)", "wanaongea": "they speak" }
        },
        {
          "question": "Why is Emma learning Swahili?",
          "options": ["She loves East Africa and her friends speak it", "For her job", "For an exam"],
          "answer": 0
        },
        {
          "line": {
            "speaker": "neema",
            "target": "Swali la mwisho: “hakuna matata” ina maana gani?",
            "base": "Last question: what does “hakuna matata” mean?"
          },
          "gloss": { "mwisho": "last, end" }
        },
        {
          "line": { "speaker": "emma", "target": "Ina maana “hakuna shida”!", "base": "It means “no problem”!" },
          "gloss": { "shida": "problem, trouble" }
        },
        { "question": "How does Neema ask “why”?", "options": ["Kwa nini", "Lini", "Wapi"], "answer": 0, "optionsLang": "target" }
      ]
