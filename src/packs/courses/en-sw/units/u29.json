  "guidebook": {
    "intro": "Christians, Muslims and followers of other faiths live side by side in East Africa, and blessings are part of everyday speech.",
    "phrases": [
      { "target": "Mungu akubariki.", "base": "God bless you." },
      { "target": "Amina!", "base": "Amen!" },
      { "target": "Bibi alizaliwa Zanzibar.", "base": "Grandma was born in Zanzibar." },
      { "target": "Mtoto anaitwa Amani.", "base": "The child is called Amani." }
    ],
    "tips": [
      {
        "id": "passive",
        "title": "Being done to: -wa",
        "body": [
          "Put **-w-** before the last **-a** and the verb becomes passive: **-ita** (call) → **-itwa** (be called), **-penda** → **-pendwa** (be loved), **-funga** → **-fungwa** (be closed, be beaten).",
          "Some change a little more: **-zaa** (give birth) → **-zaliwa** (be born). **Alizaliwa** means “he or she was born”."
        ]
      }
    ],
    "culture": [
      {
        "title": "Blessings everywhere",
        "body": [
          "People say **Mungu akubariki** (God bless you), **Mungu akipenda** (God willing) and **Asante Mungu** (thank God) in everyday talk. During **Ramadhani**, many coastal towns go quiet by day and come alive after sunset."
        ]
      }
    ]
  },
  "stories": [
    {
      "id": "sw-ramadan-evening",
      "title": "A Ramadan evening",
      "unlockAfter": "u29s2l1",
      "cast": ["bibi", "emma"],
      "summary": "Emma joins Bibi to break the fast at sunset.",
      "steps": [
        { "line": { "speaker": "emma", "target": "Bibi, umefunga leo?", "base": "Grandma, have you fasted today?" } },
        {
          "line": {
            "speaker": "bibi",
            "target": "Ndiyo, tangu alfajiri. Jua likizama, tutakula pamoja.",
            "base": "Yes, since dawn. When the sun sets, we’ll eat together."
          },
          "gloss": { "alfajiri": "dawn", "Jua likizama": "when the sun sets" }
        },
        { "question": "When will they eat?", "options": ["When the sun sets", "At dawn", "At noon"], "answer": 0 },
        { "line": { "speaker": "emma", "target": "Tutakula nini?", "base": "What will we eat?" } },
        {
          "line": {
            "speaker": "bibi",
            "target": "Tende, uji na sambusa. Karibu sana.",
            "base": "Dates, porridge and samosas. You are very welcome."
          },
          "gloss": { "uji": "porridge", "sambusa": "samosas" }
        },
        { "question": "What will they eat first?", "options": ["Dates, porridge and samosas", "Ugali", "Nothing"], "answer": 0 },
        { "line": { "speaker": "emma", "target": "Asante, bibi. Mungu akubariki.", "base": "Thank you, Grandma. God bless you." } },
        { "line": { "speaker": "bibi", "target": "Amina, mwanangu.", "base": "Amen, my child." }, "gloss": { "mwanangu": "my child" } },
        {
          "question": "How does Emma say “God bless you”?",
