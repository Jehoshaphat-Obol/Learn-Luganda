        { "line": { "speaker": "emma", "target": "Jina langu ni Emma. Wewe ni nani?", "base": "My name is Emma. Who are you?" } },
        { "line": { "speaker": "amani", "target": "Mimi ni Amani. Unatoka wapi, Emma?", "base": "I am Amani. Where are you from, Emma?" } },
