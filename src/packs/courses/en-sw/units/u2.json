      "summary": "Amani stops at Baraka’s chai stall and asks about his family.",
      "steps": [
        { "line": { "speaker": "amani", "target": "Habari za mchana, Baraka?", "base": "Good afternoon, Baraka?" } },
        { "line": { "speaker": "baraka", "target": "Nzuri, karibu! Una rafiki leo?", "base": "Fine, welcome! Do you have a friend with you today?" }, "gloss": { "leo": "today" } },
        { "line": { "speaker": "amani", "target": "Hapana. Watoto wako je?", "base": "No. And your children?" }, "gloss": { "je": "and…? (a question word)" } },
        { "line": { "speaker": "baraka", "target": "Watoto wangu ni wazuri. Nina watoto watatu.", "base": "My children are well. I have three children." } },
        { "question": "How many children does Baraka have?", "options": ["Two", "Three", "Five"], "answer": 1 },
        { "line": { "speaker": "baraka", "target": "Mtoto mmoja ni mwanafunzi, na mmoja ni mwalimu!", "base": "One child is a student, and one is a teacher!" }, "gloss": { "mmoja": "one (person)" } },
        { "question": "What does one of Baraka’s children do?", "options": ["Drives a matatu", "Teaches", "Sells chai"], "answer": 1 },
        { "line": { "speaker": "amani", "target": "Hongera, mzee!", "base": "Congratulations, sir!" } },
        { "line": { "speaker": "baraka", "target": "Asante. Karibu chai!", "base": "Thank you. Have some tea!" } }
