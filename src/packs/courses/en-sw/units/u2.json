        { "question": "Who is in the photo first?", "options": ["Neema’s grandmother", "Neema’s teacher", "Neema’s sister"], "answer": 0 },
        { "line": { "speaker": "emma", "target": "Bibi yako ni mzuri! Una kaka?", "base": "Your grandmother is lovely! Do you have a brother?" } },
