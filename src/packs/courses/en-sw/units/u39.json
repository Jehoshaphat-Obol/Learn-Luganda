  "guidebook": {
    "intro": "Good manners open every door on the coast and inland. A few words and gestures show people you respect them.",
    "phrases": [
      { "target": "Hodi! Karibu!", "base": "May I come in? Come in!" },
      { "target": "Naomba maji, tafadhali.", "base": "May I have some water, please." },
      { "target": "Pole kwa kazi!", "base": "Well done for your hard work!" },
      { "target": "Asante kwa ukarimu wako.", "base": "Thank you for your hospitality." }
    ],
    "tips": [
      {
        "id": "respect",
        "title": "Asking politely",
        "body": [
          "**Naomba** (I ask for) is much softer than **Nataka** (I want). Use it in shops, at a friend’s home and with anyone older: **Naomba chai**.",
          "At a door, call **Hodi!** and wait for **Karibu!** before you go in. Greet elders first with **Shikamoo**, and wait for **Marahaba**."
        ]
      }
    ],
    "culture": [
      {
        "title": "The right hand",
        "body": [
          "Give, receive and eat with the **right hand**, or with both hands to show extra respect. Using only the left hand can seem rude.",
          "**Pole kwa kazi** is said to anyone working, from a cook to a builder: it recognises their effort."
        ]
      }
    ]
  },
  "stories": [
    {
