      "title": "Visiting Bibi",
      "unlockAfter": "u39s3l1",
      "cast": ["emma", "bibi"],
      "summary": "Emma visits Bibi’s home and remembers her manners.",
      "steps": [
        { "line": { "speaker": "emma", "target": "Hodi!", "base": "May I come in?" } },
        {
          "line": { "speaker": "bibi", "target": "Karibu, mwanangu! Ingia.", "base": "Come in, my child! Enter." },
          "gloss": { "mwanangu": "my child", "Ingia": "come in, enter" }
        },
        { "line": { "speaker": "emma", "target": "Shikamoo, bibi.", "base": "My respects, Grandma." } },
        { "line": { "speaker": "bibi", "target": "Marahaba. Unataka chai?", "base": "Thank you. Do you want tea?" } },
        { "question": "How does Emma greet Bibi?", "options": ["Shikamoo", "Mambo", "Poa"], "answer": 0 },
        {
          "line": {
            "speaker": "emma",
            "target": "Asante. Naomba maji kwanza, tafadhali.",
            "base": "Thank you. May I have some water first, please."
          }
        },
        {
          "line": {
            "speaker": "bibi",
            "target": "Hamna shida. Haya, kula kwa mkono wa kulia!",
            "base": "No problem. Now, eat with your right hand!"
          },
          "gloss": { "Haya": "all right, now" }
        },
        { "question": "Which hand should Emma eat with?", "options": ["The right hand", "The left hand", "Either hand"], "answer": 0 },
        { "line": { "speaker": "emma", "target": "Asante kwa ukarimu wako, bibi.", "base": "Thank you for your hospitality, Grandma." } },
