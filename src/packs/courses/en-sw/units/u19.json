        },
        { "question": "How did Amani travel?", "options": ["By boat", "By plane", "By bus"], "answer": 0 },
        {
          "line": { "speaker": "bibi", "target": "Vizuri! Ulifanya nini huko?", "base": "Lovely! What did you do there?" },
          "gloss": { "huko": "there" }
