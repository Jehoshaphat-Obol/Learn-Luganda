      "id": "sw-pilau-lesson",
      "title": "Somo la pilau",
      "unlockAfter": "u24s3l1",
      "cast": ["baraka", "emma"],
      "summary": "Baraka anamfundisha Emma kupika pilau kibandani kwake Mombasa.",
      "steps": [
        {
          "line": { "speaker": "baraka", "target": "Emma, today I’ll teach you to cook pilau.", "base": "Emma, leo nitakufundisha kupika pilau." }
        },
        { "line": { "speaker": "emma", "target": "Great! What should I do first?", "base": "Safi! Kwanza nifanye nini?" } },
        {
          "line": { "speaker": "baraka", "target": "Cut the onions, then fry them in oil.", "base": "Kata vitunguu, halafu kaanga kwa mafuta." }
        },
        { "question": "Emma anafanya nini kwanza?", "options": ["Anakata vitunguu", "Anachemsha maji", "Anaongeza chumvi"], "answer": 0 },
        { "line": { "speaker": "emma", "target": "Okay. And the spices?", "base": "Sawa. Na viungo?" } },
        {
          "line": {
            "speaker": "baraka",
            "target": "Add the pilau spices, meat and rice. Then water.",
            "base": "Ongeza bizari ya pilau, nyama na mchele. Halafu maji."
          }
        },
        { "question": "Nini kinaingia pamoja na viungo?", "options": ["Nyama na mchele", "Sukari", "Maziwa"], "answer": 0 },
        { "line": { "speaker": "emma", "target": "It smells really good!", "base": "Inanukia vizuri sana!" } },
        {
          "line": {
            "speaker": "baraka",
            "target": "Come and eat! Your pilau is tastier than mine!",
            "base": "Karibu chakula! Pilau yako ni tamu kuliko yangu!"
