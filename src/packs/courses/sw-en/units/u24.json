  "guidebook": {
    "intro": "Fuata mapishi ya pilau kwa Kiingereza, na jifunze amri ambazo mpishi hutoa jikoni.",
    "phrases": [
      { "target": "Put the pot on the fire.", "base": "Weka sufuria motoni." },
      { "target": "Cut the onion.", "base": "Kata kitunguu." },
