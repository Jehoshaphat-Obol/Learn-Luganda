  "guidebook": {
    "intro": "Unatumaini hutayahitaji maneno haya, lakini kuyajua kutakutuliza jambo baya likitokea.",
    "phrases": [
      { "target": "There has been an accident!", "base": "Kumetokea ajali!" },
