  "guidebook": {
    "intro": "Kazi za nyumbani: amri fupi, kusafisha na kuomba msaada.",
    "phrases": [
      { "target": "Come here!", "base": "Njoo hapa!" },
      { "target": "Sit down, please.", "base": "Kaa, tafadhali." },
