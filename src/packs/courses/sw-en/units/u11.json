      { "target": "Thanks for the help!", "base": "Asante kwa msaada!" }
    ],
    "tips": [
      {
        "id": "commands",
        "title": "Amri: kitenzi tu",
        "body": [
          "Amri ya Kiingereza ni kitenzi chenyewe: **Come!** (njoo), **Sit down!** (kaa), **Bring water.** (leta maji). Ni ile ile kwa mtu mmoja au wengi.",
          "Kukataza, weka **Don’t** mbele: **Don’t sit there!** (usikae hapo)."
        ]
      },
      {
        "id": "polite-asking",
        "title": "Kuomba kwa adabu",
        "body": [
          "Amri peke yake inaweza kusikika kali. Ongeza **please**: **Close the door, please.**",
          "Kwa adabu zaidi, uliza: **Can you help me?** au **Could you open the window?**"
        ]
      }
    ],
    "culture": [
      {
        "title": "Asante kwa kazi",
        "body": ["Kazi ikiisha, Kiingereza husifu: **Good job!** au **Well done!** Na mtu akikushukuru, jibu: **You’re welcome!** (karibu)."]
      }
    ]
  },
  "stories": [
    {
      "id": "sw-saturday-chores",
      "title": "Kazi za Jumamosi",
      "unlockAfter": "u11s3l2",
      "cast": ["bibi", "neema"],
      "summary": "Bibi na Neema wanasafisha nyumba siku ya Jumamosi.",
      "steps": [
        {
          "line": {
            "speaker": "bibi",
            "target": "Neema, today is Saturday. Let’s clean the house!",
            "base": "Neema, leo ni Jumamosi. Tusafishe nyumba!"
          }
        },
        { "line": { "speaker": "neema", "target": "Okay, Grandma. Where shall I start?", "base": "Sawa, bibi. Nianze wapi?" } },
        {
          "line": { "speaker": "bibi", "target": "First wash the dishes, then sweep outside.", "base": "Kwanza osha vyombo, halafu fagia nje." }
        },
        { "question": "Neema anafanya nini kwanza?", "options": ["Anaosha vyombo", "Anafagia nje", "Anapika"], "answer": 0 },
        { "line": { "speaker": "neema", "target": "I’ve finished the dishes! And now?", "base": "Nimemaliza vyombo! Na sasa?" } },
        {
          "line": {
            "speaker": "bibi",
            "target": "Now sweep, and close the window. It’s windy.",
            "base": "Sasa fagia, na funga dirisha. Kuna upepo."
          }
        },
        { "question": "Kwa nini Neema afunge dirisha?", "options": ["Kuna upepo", "Mvua inanyesha", "Ni giza"], "answer": 0 },
        {
          "line": {
            "speaker": "neema",
            "target": "Good job, Grandma! The house is completely clean.",
            "base": "Kazi nzuri, bibi! Nyumba ni safi kabisa."
          }
        },
        {
          "line": {
            "speaker": "bibi",
            "target": "Thanks for the help. Many hands, light work.",
            "base": "Asante kwa msaada. Mikono mingi, kazi nyepesi."
          }
        },
        {
          "question": "Methali ya Bibi inamaanisha nini?",
          "options": ["Mikono mingi hurahisisha kazi", "Kazi ni nzito", "Osha mikono"],
          "answer": 0
        }
      ]
    }
