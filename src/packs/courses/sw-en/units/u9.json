    "tips": [
      {
        "id": "adj-before",
        "title": "Kivumishi kwanza",
        "body": [
          "Kiswahili husema **kikombe kipya**; Kiingereza hupindua: **a new cup**. Kivumishi huja **kabla** ya nomino.",
          "Baada ya **is/are**, kivumishi hukaa mwisho kama Kiswahili: **The cup is new.** (Kikombe ni kipya.)"
        ]
      },
      {
        "id": "plural-s",
        "title": "Wengi: ongeza -s",
        "body": [
          "Nomino nyingi huongeza **-s**: **cup → cups**, **book → books**. Kivumishi hakibadiliki: **a big cup → big cups**.",
          "Hakuna ngeli: **new** ni ile ile kwa kikombe, nyumba au mtoto."
        ]
      }
    ],
    "culture": [
      {
        "title": "“Very” na “really”",
        "body": [
          "Kwa kusifu, Kiingereza huongeza **very** au **really**: **very good**, **really nice**. **Safi kabisa!** inaweza kuwa **Absolutely great!** au **Brilliant!**"
        ]
      }
    ]
  },
