    "tips": [
      {
        "id": "odd-plurals",
        "title": "Wingi usio wa kawaida",
        "body": [
          "Wanyama wengi huongeza **-s**: **goat → goats**, **lion → lions**. Wengine hawabadiliki: **sheep → sheep**, **fish → fish**.",
          "Na watu: **child → children**, **person → people**, **man → men**."
        ]
      },
      {
        "id": "there-are",
        "title": "“There is” na “there are”",
        "body": [
          "**Kuna** ni **there is** kwa kimoja na **there are** kwa vingi: **There is a lion.** **There are many animals.**",
          "Kuuliza: **Are there any elephants?**"
        ]
      }
    ],
