    "tips": [
      {
        "id": "plurals",
        "title": "Ekimu n’ebingi",
        "body": [
          "Mu Luganda ente emu ne ente nnyingi kigambo kye kimu. Mu Lungereza bulijjo oyongerako **-s**: **one cow, two cows**, **a goat, many goats**.",
          "Ebigambo ebimu tebikyuka: **one sheep, two sheep**; **one fish, many fish**."
        ],
        "table": [
          ["Kimu", "Bingi"],
          ["a cow", "cows"],
          ["a goat", "goats"],
          ["a sheep", "sheep"],
          ["an animal", "animals"]
        ]
      },
      {
        "id": "there-is",
        "title": "“There is” ne “there are”",
        "body": [
          "**Waliwo** mu Lungereza kiba **there is** ku kimu ne **there are** ku bingi: **There is a lion. There are many animals.**",
          "Okubuuza: **Is there a lion?** **Are there elephants?**"
        ]
      }
    ],
    "culture": [
      {
        "title": "Engaali",
        "body": [
          "Engaali kinyonyi kya ggwanga: **The crested crane is Uganda’s national bird.** Eri ku bendera ne ku nkoofiira z’abaserikale."
        ]
      }
    ]
  },
  "stories": [
    {
      "id": "village-farm",
      "title": "Ku faamu ya Jjajja",
      "unlockAfter": "u13s3l3",
      "cast": ["emma", "jjajja"],
      "summary": "Emma akyalira ekyalo era alaba ebisolo.",
      "steps": [
        {
          "line": {
            "speaker": "jjajja",
            "target": "We are happy to see you, Emma! Come in.",
            "base": "Tusanyuse okukulaba, Emma! Yingira."
          }
        },
        {
          "line": {
            "speaker": "emma",
            "target": "Thank you, Grandma. Where are the animals?",
            "base": "Weebale, Jjajja. Ebisolo biri wa?"
          }
        },
        {
          "line": {
            "speaker": "jjajja",
            "target": "Look! The cows are eating grass.",
            "base": "Laba! Ente zirya omuddo."
          }
        },
        {
          "question": "Ente zikola ki?",
          "options": ["Sleeping", "Eating grass", "Drinking water"],
          "optionsLang": "target",
          "answer": 1
        },
        {
          "line": {
            "speaker": "emma",
            "target": "How many cows?",
            "base": "Ente mmeka?"
          }
        },
        {
          "line": {
            "speaker": "jjajja",
            "target": "Five cows and ten goats.",
            "base": "Ente ttaano n’embuzi kkumi."
          }
        },
        {
          "question": "Jjajja alina embuzi mmeka?",
          "options": ["Five", "Two", "Ten"],
          "optionsLang": "target",
          "answer": 2
        },
        {
          "line": {
            "speaker": "emma",
            "target": "Oh! A snake!",
            "base": "Ayi! Omusota!"
          }
        },
        {
          "line": {
            "speaker": "jjajja",
            "target": "No, my child. That is a rope.",
            "base": "Nedda, mwana wange. Ogwo muguwa."
          }
        },
        {
          "question": "Emma kiki kye yalaba ddala?",
          "options": ["A rope", "A snake", "A dog"],
          "optionsLang": "target",
          "answer": 0
        },
        {
          "line": {
            "speaker": "emma",
            "target": "Haha! I’m really afraid of snakes.",
            "base": "Haha! Ntya omusota nnyo."
          }
        },
        {
          "line": {
            "speaker": "jjajja",
            "target": "Look up: a crested crane is flying!",
            "base": "Laba waggulu: engaali ebuuka!"
          }
        },
        {
          "line": {
            "speaker": "emma",
            "target": "It’s so beautiful!",
            "base": "Nnungi nnyo!"
          }
        }
      ]
    }
  ]
}
