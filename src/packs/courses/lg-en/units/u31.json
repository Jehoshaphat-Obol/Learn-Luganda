    "tips": [
      {
        "id": "business",
        "title": "“How is business?”",
        "body": [
          "Okubuuza ku bizinensi: **How is business?** Okuddamu: **Business is good.** oba **Good. Today there are many customers.**"
        ]
      },
      {
        "id": "any",
        "title": "“I don’t have any”",
        "body": [
          "Mu sentensi egaana kozesa **any**: **I don’t have any debt.** **We don’t have any sugar.** Mu sentensi ekkiriza kozesa **some** oba **a lot of**: **I have made a lot of profit.**"
        ]
      },
      {
        "id": "teach",
        "title": "Okukozesa omuntu",
        "body": [
          "Mu Luganda ekikolwa kikyuka: **nsoma → nsomesa**, **ndya → ndisa**, **nnywa → nnywesa**. Mu Lungereza bitera okuba ebikolwa ebirala: **I teach**, **I feed**, oba **I give … a drink**: **I give the cows water.**"
        ],
        "table": [
          ["Oluganda", "Olungereza"],
          ["nsoma → nsomesa", "I study → I teach"],
          ["ndya → ndisa", "I eat → I feed"],
          ["nnywa → nnywesa", "I drink → I give a drink to"]
        ]
      }
    ],
    "culture": [
