  "guidebook": {
    "intro": "Manya ebitundu by’omubiri, gamba ekikuluma, era oyogere n’omusawo mu Lungereza.",
    "phrases": [
      {
        "target": "I am sick.",
        "base": "Ndi mulwadde."
      },
      {
        "target": "My head hurts.",
        "base": "Omutwe gunnuma."
      },
      {
        "target": "My stomach hurts.",
        "base": "Olubuto lunnuma."
      },
      {
        "target": "I have a fever.",
        "base": "Nnina omusujja."
      },
      {
        "target": "I am going to the hospital.",
        "base": "Ŋŋenda mu ddwaliro."
      },
      {
        "target": "Get well soon!",
        "base": "Wona mangu!"
      }
    ],
    "tips": [
      {
        "id": "my-head-hurts",
        "title": "“My head hurts”",
        "body": [
          "Mu Luganda ogamba **Omutwe gunnuma**. Mu Lungereza oteekamu **my**: **My head hurts.** **My stomach hurts.**",
          "Era osobola okugamba **I have a headache** oba **I have a stomach ache**."
        ]
      }
    ],
    "culture": [
      {
        "title": "Mu ddwaliro",
        "body": [
          "Abasawo mu Uganda batera okwogera Olungereza. Ebigambo bino bikuyamba: **I am sick**, **I have a fever**, **It hurts here**. Bw’otategeera, gamba **Please say it again slowly.**"
        ]
      }
    ]
  },
  "stories": [
    {
      "id": "doctor-visit",
      "title": "Mu ddwaliro",
      "unlockAfter": "u8s3l2",
      "cast": ["amara", "mukasa"],
      "summary": "Amara tawulira bulungi era alaba omusawo.",
      "steps": [
        {
          "line": {
            "speaker": "mukasa",
            "target": "How are you, Amara?",
            "base": "Oli otya, Amara?"
          }
        },
        {
          "line": {
            "speaker": "amara",
            "target": "I am sick. My head hurts.",
            "base": "Ndi mulwadde. Omutwe gunnuma."
          }
        },
        {
          "question": "Kiki ekimuluma?",
          "options": ["Olubuto", "Omutwe", "Okugulu"],
          "answer": 1
        },
        {
          "line": {
            "speaker": "mukasa",
            "target": "Do you have a fever?",
            "base": "Olina omusujja?"
          }
        },
        {
          "line": {
            "speaker": "amara",
            "target": "Yes, I have a fever.",
            "base": "Yee, nnina omusujja."
          }
        },
        {
          "line": {
            "speaker": "mukasa",
            "target": "Take this medicine and rest.",
            "base": "Nywa eddagala lino, owummule."
          }
        },
        {
          "question": "Mukasa awa Amara ki?",
          "options": ["Eddagala", "Caayi", "Matooke"],
          "answer": 0
        },
        {
          "line": {
            "speaker": "amara",
            "target": "Thank you very much, doctor.",
            "base": "Weebale nnyo, musawo."
          }
        },
        {
          "line": {
            "speaker": "mukasa",
            "target": "Okay. Get well soon!",
            "base": "Kale. Wona mangu!"
          }
        }
      ]
    }
  ]
