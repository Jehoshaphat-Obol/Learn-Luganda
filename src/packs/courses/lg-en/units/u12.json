    "tips": [
      {
        "id": "it-is-raining",
        "title": "Olungereza lukozesa “it”",
        "body": [
          "Mu Luganda enkuba ye ekola: **enkuba etonnya**. Mu Lungereza otandika ne **it**: **It is raining.** **It is hot.** **It is cold today.**",
          "Ku musana: **The sun is shining.**"
        ]
      },
      {
        "id": "seasons",
        "title": "Ebiseera by’omwaka",
        "body": [
          "**The rainy season** ye ttoggo, **the dry season** kye kyeya. Kozesa **in the**: **In the rainy season there is a lot of rain.**",
          "Mu nsi ezimu waliwo ebiseera bina: **spring, summer, autumn, winter**."
        ]
      }
    ],
    "culture": [
      {
        "title": "Okutandika emboozi",
        "body": [
          "Aboogera Olungereza batera okutandika emboozi n’obudde: **Nice weather today!** oba **It’s so hot!** Kiba kirungi okuddamu: **Yes, it is!**"
        ]
      }
    ]
  },
  "stories": [
    {
      "id": "rainy-day",
      "title": "Olweggulo lw’enkuba",
      "unlockAfter": "u12s3l3",
      "cast": ["amara", "jjajja"],
      "summary": "Enkuba ey’amaanyi ekuuma Amara ewa jjajja we.",
      "steps": [
        {
          "line": {
            "speaker": "amara",
            "target": "Grandma, I am going home.",
            "base": "Jjajja, ŋŋenda awaka."
          }
        },
        {
          "line": {
            "speaker": "jjajja",
            "target": "No! Look, there are lots of clouds. Rain is coming.",
            "base": "Nedda! Laba, ebire bingi. Enkuba ejja."
          }
        },
        {
          "question": "Lwaki Jjajja agamba nedda?",
          "options": ["It is late", "Rain is coming", "Amara is sick"],
          "optionsLang": "target",
          "answer": 1
        },
        {
          "line": {
            "speaker": "amara",
            "target": "But the sun is shining!",
            "base": "Naye omusana gwaka!"
          }
        },
        {
          "line": {
            "speaker": "jjajja",
            "target": "Listen… it’s thundering.",
            "base": "Wuliriza… eggulu libwatuka."
          }
        },
        {
          "line": {
            "speaker": "amara",
            "target": "Oh! It’s raining really hard!",
            "base": "Ayi! Enkuba etonnya nnyo nnyo!"
          }
        },
        {
          "question": "Obudde buli butya kati?",
          "options": ["Sunny and hot", "Raining very hard", "Cool and dry"],
          "optionsLang": "target",
          "answer": 1
        },
        {
          "line": {
            "speaker": "jjajja",
            "target": "Sit here. I feel cold. And you?",
            "base": "Tuula wano. Mpulira empewo. Ggwe?"
          }
        },
        {
          "line": {
            "speaker": "amara",
            "target": "Me too. I want tea.",
            "base": "Nange. Njagala caayi."
          }
        },
        {
          "line": {
            "speaker": "jjajja",
            "target": "Okay, let’s drink tea. Afterwards, take my umbrella.",
            "base": "Kale, tunywe caayi. Oluvannyuma, twala ekiwempe kyange."
          }
        },
        {
          "question": "Amara anaatwala ki eka?",
          "options": ["Jjajja’s umbrella", "A sweater", "Some food"],
          "optionsLang": "target",
          "answer": 0
        },
        {
          "line": {
            "speaker": "amara",
            "target": "Thank you very much, Grandma!",
            "base": "Weebale nnyo, Jjajja!"
          }
        }
      ]
    }
  ]
