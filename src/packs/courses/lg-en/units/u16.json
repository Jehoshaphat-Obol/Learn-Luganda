  "guidebook": {
    "intro": "Kwata ttakisi oba bbaasi, kozesa bodaboda, era ogambe nti otuuse bulungi.",
    "phrases": [
      {
        "target": "Where does this taxi go?",
        "base": "Ttakisi eno egenda wa?"
      },
      {
        "target": "Stop at the stage.",
        "base": "Yimirira ku siteegi."
      },
      {
        "target": "Go slowly, sir!",
        "base": "Genda mpola, ssebo!"
      },
      {
        "target": "From Kampala to Masaka.",
        "base": "Okuva e Kampala okutuuka e Masaka."
      },
      {
        "target": "I have arrived safely.",
        "base": "Ntuuse bulungi."
      },
      {
        "target": "Have a good journey!",
        "base": "Olugendo olulungi!"
      }
    ],
    "tips": [
      {
        "id": "does-it-go",
        "title": "“Where does this taxi go?”",
        "body": [
          "Okubuuza ku muntu omu oba ekintu ekimu, kozesa **does**: **Where does this taxi go?** **Does this bus go to Jinja?** Okuddamu: **It goes to Entebbe.** (**goes** ne **-es**)."
        ]
      },
      {
        "id": "from-to",
        "title": "From … to … ne by …",
        "body": [
          "**From Kampala to Masaka** — okuva e Kampala okutuuka e Masaka.",
          "Ekidduka ky’olinnya: **by**: **by taxi**, **by bus**, **by boda boda**, **by plane**. Naye ku bigere: **on foot**."
        ]
      }
    ],
    "culture": [
      {
        "title": "Okutuuka obulungi",
        "body": [
          "Bw’otuuka, abantu baagala okumanya. Mu Lungereza gamba **I have arrived safely.** Mu Uganda abantu era bagamba **I have reached.** Bw’oba osiibula omuntu agenda: **Have a good journey!** oba **Safe journey!**"
        ]
      }
    ]
  },
  "stories": [
    {
      "id": "taxi-to-jinja",
      "title": "Ttakisi egenda e Jinja",
      "unlockAfter": "u16s3l3",
      "cast": ["nakato", "ssali"],
      "summary": "Nakato afuna ttakisi entuufu era atuuka e Jinja.",
      "steps": [
        {
          "line": {
            "speaker": "nakato",
            "target": "Sir, where does this taxi go?",
            "base": "Ssebo, ttakisi eno egenda wa?"
          }
        },
        {
          "line": {
            "speaker": "ssali",
            "target": "It goes to Mukono. Where are you going?",
            "base": "Egenda Mukono. Ggwe ogenda wa?"
          }
        },
        {
          "line": {
            "speaker": "nakato",
            "target": "I am going to Jinja.",
            "base": "Ŋŋenda Jinja."
          }
        },
        {
          "question": "Nakato ayagala kugenda wa?",
          "options": ["Mukono", "Jinja", "Masaka"],
          "optionsLang": "target",
          "answer": 1
        },
        {
          "line": {
            "speaker": "ssali",
            "target": "The Jinja taxi is over there, at the stage.",
            "base": "Ttakisi ya Jinja eri eri, ku siteegi."
          }
        },
        {
          "line": {
            "speaker": "nakato",
            "target": "Thank you very much! How much is it to Jinja?",
            "base": "Weebale nnyo! Ssente mmeka okutuuka e Jinja?"
          }
        },
        {
          "line": {
            "speaker": "ssali",
            "target": "Ten thousand.",
            "base": "Omutwalo gumu."
          }
        },
        {
          "question": "Okusasula kwa ssente mmeka?",
          "options": ["Five thousand", "Ten thousand", "One thousand"],
          "optionsLang": "target",
          "answer": 1
        },
        {
          "line": {
            "speaker": "nakato",
            "target": "Is the journey long?",
            "base": "Olugendo luwanvu?"
          }
        },
        {
          "line": {
            "speaker": "ssali",
            "target": "No, only two hours.",
            "base": "Nedda, ssaawa bbiri zokka."
          }
        },
        {
          "line": {
            "speaker": "nakato",
            "target": "Okay. Let’s go!",
            "base": "Kale. Tugende!"
          }
        },
        {
          "question": "Nakato agamba atya maama we nti atuuse, mu Lungereza?",
          "options": ["I have arrived safely.", "Go slowly.", "Stop here."],
          "optionsLang": "target",
          "answer": 0
        },
        {
          "line": {
            "speaker": "nakato",
            "target": "Mum, I have arrived safely in Jinja!",
            "base": "Maama, ntuuse bulungi e Jinja!"
          }
        }
      ]
    }
  ]
