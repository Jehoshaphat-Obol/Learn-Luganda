    "tips": [
      {
        "id": "play",
        "title": "“Play the drum”",
        "body": [
          "Mu Luganda **okukuba engoma**. Mu Lungereza ku bivuga byonna ogamba **play**: **play the drum**, **play the harp**, **play the xylophone**."
        ]
      },
      {
        "id": "who",
        "title": "“Who” ku bantu",
        "body": [
          "Mu Luganda **abazina** kitegeeza “abo abazina”. Mu Lungereza kozesa **who** ku bantu: **the children who are dancing**, **the man who plays the drum**.",
          "Ku bintu kozesa **that** oba **which**: **the song that I like**."
        ]
      }
    ],
    "culture": [
      {
        "title": "Engoma",
        "body": [
          "Engoma ekulu nnyo mu Buganda: ekuŋŋaanya abantu era eraga ebiseera by’emikolo. Mu Lungereza: **The drum calls people together.** **Bakisimba is a royal dance.**"
        ]
      }
    ]
  },
  "stories": [
    {
      "id": "drum-lesson",
      "title": "Okuyiga okukuba engoma",
      "unlockAfter": "u29s3l3",
      "cast": ["amara", "mukasa"],
      "summary": "Amara ayiga okukuba engoma olw’ekivvulu ky’essomero.",
      "steps": [
        {
          "line": {
            "speaker": "amara",
            "target": "Sir, I want to play the drum at the school concert.",
            "base": "Ssebo, njagala okukuba engoma ku mukolo gw’essomero."
          }
        },
        {
          "line": {
            "speaker": "mukasa",
            "target": "Good! Hold this drum.",
            "base": "Kirungi! Kwata engoma eno."
          }
        },
        {
          "line": {
            "speaker": "amara",
            "target": "The big one or the small one?",
            "base": "Ennene oba entono?"
          }
        },
        {
          "line": {
            "speaker": "mukasa",
            "target": "The small one. Listen: bum, bum, ka-bum.",
            "base": "Entono. Wuliriza: bum, bum, ka-bum."
          }
        },
        {
          "question": "Amara akuba ngoma ki?",
          "options": ["The big one", "The small one", "No drum"],
          "optionsLang": "target",
          "answer": 1
        },
        {
          "line": {
            "speaker": "amara",
            "target": "Bum, bum, ka-bum! It’s great fun!",
            "base": "Bum, bum, ka-bum! Kinyuma nnyo!"
          }
        },
        {
          "line": {
            "speaker": "mukasa",
            "target": "The children who dance will dance Bakisimba.",
            "base": "Abaana abazina bajja kuzina Bakisimba."
          }
        },
        {
          "question": "Abazinyi banaazina ki?",
          "options": ["Bakisimba", "Football", "Omweso"],
          "optionsLang": "target",
          "answer": 0
        },
        {
          "line": {
            "speaker": "amara",
            "target": "And who will sing?",
            "base": "Ate ani ajja kuyimba?"
          }
        },
        {
          "line": {
            "speaker": "mukasa",
            "target": "Nakato! She is a good singer.",
            "base": "Nakato! Ye muyimbi omulungi."
          }
        },
        {
          "question": "Mu Lungereza ogamba otya “abaana abazina”?",
          "options": [
            "the children who dance",
            "the children dance",
            "the children play"
          ],
          "optionsLang": "target",
          "answer": 0
        },
        {
          "line": {
            "speaker": "amara",
            "target": "I’m so happy. Thank you, sir!",
            "base": "Nsanyuse nnyo. Weebale, ssebo!"
          }
        }
      ]
    }
  ]
