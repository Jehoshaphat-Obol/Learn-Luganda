    "tips": [
      {
        "id": "everyone",
        "title": "Ekiragiro kye kimu",
        "body": [
          "Mu Luganda omusomesa agamba omuntu omu **soma**, n’abangi **musome**. Mu Lungereza kye kimu: **Read!** Okulaga nti oyogera n’abantu bonna, yongerako **everyone**: **Read the book, everyone.**"
        ]
      },
      {
        "id": "capitals",
        "title": "Ennukuta ennene",
        "body": [
          "Amannya g’ennimi gatandika n’ennukuta ennene: **English**, **Luganda**, **Swahili**. Amasomo amalala tegatandika nazo: **maths**, **science**, **history**."
        ]
      },
      {
        "id": "questions",
        "title": "Okubuuza mu kibiina",
        "body": [
          "**Do you understand?** — **Yes, I understand.** oba **No, I don’t understand.**",
          "Bw’oba toyidde, gamba **Please repeat slowly.** oba **I have a question.**"
        ]
      }
    ],
    "culture": [
      {
        "title": "Olungereza ku ssomero",
        "body": [
