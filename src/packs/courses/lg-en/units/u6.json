  "guidebook": {
    "intro": "Manya ebifo mu kibuga n’ennyumba, gamba gy’ogenda, era olage oba obuuze ekkubo mu Lungereza.",
    "phrases": [
      {
        "target": "Where are you going?",
        "base": "Ogenda wa?"
      },
      {
        "target": "I am going home.",
        "base": "Ŋŋenda awaka."
      },
      {
        "target": "Where is the hospital?",
        "base": "Eddwaliro liri wa?"
      },
      {
        "target": "Turn right.",
