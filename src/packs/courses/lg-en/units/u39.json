    "tips": [
      {
        "id": "greeting-elders",
        "title": "Okulamusa abakadde",
        "body": [
          "Aboogera Olungereza tebafukamira. Ekitiibwa kiri mu bigambo: **Good morning, sir. Good afternoon, madam.** Ku bannaffe abatamanyiddwa: **Mr Mukasa**, **Mrs Nalwoga**, **Ms Nakato**."
        ]
      },
      {
        "id": "polite",
        "title": "“You” y’emu",
        "body": [
          "Mu Luganda tukozesa obungi okulaga ekitiibwa: **mwasuze**, **mwebale**. Mu Lungereza **you** y’emu eri buli muntu. Ekitiibwa kiva mu **please**, **thank you** ne **would you**: **Would you like some tea?**"
        ]
      },
      {
        "id": "guest",
        "title": "Okusembeza omugenyi",
        "body": [
          "**Come in! Please sit down. Make yourself at home.** Okuwa emmere: **Please have some food.** Omugenyi addamu: **Thank you for having me.**"
        ]
      }
    ],
    "culture": [
      {
        "title": "Omugenyi asooka",
        "body": [
          "Mu Uganda omugenyi aweebwa ekifo ekisinga n’emmere esooka. Ku bagenyi aboogera Olungereza, nnyonnyola: **In Uganda the guest always comes first.**"
        ]
      }
    ]
  }
