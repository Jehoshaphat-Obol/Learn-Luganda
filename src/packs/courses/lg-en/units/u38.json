    "tips": [
      {
        "id": "help",
        "title": "Okusaba obuyambi",
        "body": [
          "Ebigambo bimpi era byangu: **Help! Fire! Thief! Hurry! Call the police!** Mu Uganda kuba **112** oba **999**."
        ]
      },
      {
        "id": "was-stolen",
        "title": "Has been stolen",
        "body": [
          "Mu Luganda **ebbiddwa**, **alumiziddwa**. Mu Lungereza kozesa **has been** oba **was** n’ekikolwa: **My phone has been stolen. My phone was stolen.** Ku muntu: **The man is injured.**"
        ]
      },
      {
        "id": "okay",
        "title": "Are you okay?",
        "body": [
          "**Are you okay?** — **Yes, I’m okay.** Omuntu bw’akwebaza, oddamu: **No problem.** oba **You’re welcome.**"
        ]
      }
    ],
    "culture": [
      {
        "title": "Okufuna obuyambi",
        "body": [
          "Ku kabenje, abantu bayamba mangu. Gamba abali okumpi: **Please help! Call an ambulance!** Bw’oba oli mugenyi, buuza: **Where is the police station?**"
        ]
      }
    ]
  },
  "stories": [
    {
      "id": "stolen-phone",
      "title": "Essimu ebbiddwa",
      "unlockAfter": "u38s3l3",
      "cast": ["nakato", "ssali"],
      "summary": "Essimu ya Nakato ebbibwa mu katale, ne Ssali amuyamba.",
      "steps": [
        {
          "line": {
            "speaker": "nakato",
            "target": "Thief! Thief! Help me!",
            "base": "Omubbi! Omubbi! Nnyamba!"
          }
        },
        {
          "line": {
            "speaker": "ssali",
            "target": "Nakato! What happened?",
            "base": "Nakato! Kiki ekibaddewo?"
          }
        },
        {
          "line": {
            "speaker": "nakato",
            "target": "My phone has been stolen! A man ran off that way.",
            "base": "Essimu yange ebbiddwa! Omusajja adduse n’agenda eri."
          }
        },
        {
          "question": "Kiki ekyatuuka ku Nakato?",
          "options": [
            "Her phone was stolen",
            "She was in an accident",
            "She lost her bag"
          ],
          "optionsLang": "target",
          "answer": 0
        },
        {
          "line": {
            "speaker": "ssali",
            "target": "Are you okay? Are you hurt?",
            "base": "Oli bulungi? Olumiziddwa?"
          }
        },
        {
          "line": {
            "speaker": "nakato",
            "target": "No, I’m okay. But I’m very scared.",
            "base": "Nedda, ndi bulungi. Naye ntidde nnyo."
          }
        },
        {
          "line": {
            "speaker": "ssali",
            "target": "Sit here and wait. I will call the police.",
            "base": "Tuula wano, linda. Nja kukubira poliisi essimu."
          }
        },
        {
          "question": "Ssali akola ki?",
          "options": [
            "He chases the thief",
            "He calls the police",
            "He calls an ambulance"
          ],
          "optionsLang": "target",
          "answer": 1
        },
        {
          "line": {
            "speaker": "ssali",
            "target": "The police say that they are coming quickly.",
            "base": "Poliisi egamba nti ejja mangu."
          }
        },
        {
          "line": {
            "speaker": "nakato",
            "target": "Thank you very much, Ssali.",
            "base": "Weebale nnyo, Ssali."
          }
        },
        {
          "question": "Nakato bw’agamba “Thank you very much”, Ssali addamu atya?",
          "options": ["No problem.", "Hurry!", "Help me!"],
          "optionsLang": "target",
          "answer": 0
        },
        {
          "line": {
            "speaker": "ssali",
            "target": "No problem. That’s what friends are for!",
            "base": "Tewali kizibu. Ky’omukwano!"
          }
        }
      ]
    }
  ]
