      "cast": ["emma", "ssali"],
      "summary": "Ssali atwala Emma okulaba Kiyira w’atandikira.",
      "steps": [
        {
          "line": {
            "speaker": "ssali",
            "target": "We’ve arrived in Jinja! Look, the Nile.",
            "base": "Tutuuse e Jinja! Laba, Kiyira."
          }
        },
        {
          "line": {
            "speaker": "emma",
            "target": "Where does the Nile start?",
            "base": "Wa Kiyira w’atandikira?"
          }
        },
        {
          "line": {
            "speaker": "ssali",
            "target": "Here! The water comes out of Lake Victoria.",
            "base": "Wano! Amazzi gava mu Nnalubaale."
          }
        },
        {
          "question": "Amazzi ga Kiyira gava wa?",
          "options": ["Lake Victoria", "The forest", "The rain only"],
          "optionsLang": "target",
          "answer": 0
        },
        {
          "line": {
            "speaker": "emma",
            "target": "What is that bird?",
            "base": "Ekinyonyi ekyo kiki?"
          }
        },
        {
          "line": {
            "speaker": "ssali",
            "target": "That’s a crested crane! It’s flying over the river.",
            "base": "Ekyo ngaali! Ebuuka waggulu w’omugga."
          }
        },
        {
          "line": {
            "speaker": "emma",
            "target": "The flowers and trees are very beautiful here.",
            "base": "Ebimuli n’emiti birungi nnyo wano."
          }
        },
        {
          "line": {
            "speaker": "ssali",
            "target": "Yes. But look, rubbish on the shore.",
            "base": "Yee. Naye laba, kasasiro ku lubalama."
          }
        },
        {
          "question": "Ssali alaba ki ku lubalama?",
          "options": ["Rubbish", "A lion", "A boat"],
          "optionsLang": "target",
          "answer": 0
        },
        {
          "line": {
            "speaker": "emma",
            "target": "Let’s protect our land! Let’s pick up the rubbish.",
            "base": "Tukuume ettaka lyaffe! Tukung’aanye kasasiro."
          }
        },
        {
          "question": "Mu Lungereza ogamba otya “Tukuume ettaka lyaffe”?",
          "options": [
            "Let’s protect our land",
