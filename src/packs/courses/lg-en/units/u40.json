    "tips": [
      {
        "id": "the-hare",
        "title": "Wakayima",
        "body": [
          "Mu Lungereza Wakayima ayitibwa **the hare**. Enfumo zinyumizibwa mu byayita: **The hare was very clever. The hare tricked the elephant.** (**trick → tricked**)."
        ]
      },
      {
        "id": "retelling",
        "title": "Okunnyonnyola abantu",
        "body": [
          "Omuntu omupya mu lufumo omunnyonnyola amangu: **Kintu married Nnambi, the daughter of Ggulu.** Era: **Walumbe (Death)**, **Ggulu, the king of the sky**."
        ]
      },
      {
        "id": "teaches-us",
        "title": "Essomo ly’olufumo",
        "body": [
          "**What does this story teach us?** — **It teaches us that wisdom beats strength.** Oba: **The moral of the story is …**"
        ]
      }
    ],
    "culture": [
      {
        "title": "Okunyumya nate",
        "body": [
          "Bw’onyumiza mukwano gwo ow’ebweru olufumo lwa Buganda mu Lungereza, amannya gaabwe galeke nga bwe gali: **Kintu**, **Nnambi**, **Walumbe**. Gano ge gafuula olufumo olwaffe."
        ]
      }
    ]
  },
  "stories": [
    {
      "id": "kintu-and-nnambi",
      "title": "Kintu ne Nnambi",
      "unlockAfter": "u40s3l3",
      "cast": ["jjajja", "emma"],
      "summary": "Jjajja anyumiza Emma olufumo lw’engeri okufa gye kwajja ku nsi.",
      "steps": [
        {
          "line": {
            "speaker": "emma",
            "target": "Grandma, I hear there is a story about Kintu. Tell me!",
            "base": "Jjajja, mpulira nti waliwo enfumo ya Kintu. Ngerera!"
          }
        },
        {
          "line": {
            "speaker": "jjajja",
            "target": "Well. Once upon a time, Kintu was the first person. He lived alone with his cow.",
            "base": "Kale. Olwatuuka olwali olumu, Kintu ye muntu eyasooka. Yabeeranga yekka n’ente ye."
          }
        },
        {
          "line": {
            "speaker": "jjajja",
            "target": "Then Nnambi, the daughter of Ggulu, loved him. Kintu married her.",
            "base": "Awo Nnambi, muwala wa Ggulu, n’amwagala. Kintu n’amuwasa."
          }
        },
        {
          "question": "Nnambi yali ani?",
          "options": ["Ggulu’s daughter", "Kintu’s sister", "A clever hare"],
          "optionsLang": "target",
          "answer": 0
        },
        {
          "line": {
            "speaker": "jjajja",
            "target": "Ggulu said: “Go quickly, so that Death does not follow you.”",
            "base": "Ggulu n’agamba nti: “Mugende mangu, Walumbe aleme okubagoberera.”"
          }
        },
        {
          "line": {
            "speaker": "jjajja",
            "target": "But on the way, Nnambi forgot the chicken’s millet. She went back.",
            "base": "Naye mu kkubo, Nnambi yeerabira obulo bw’enkoko. N’addayo."
          }
        },
        {
          "question": "Lwaki Nnambi yaddayo?",
          "options": [
            "For her cow",
            "For the chicken’s millet",
            "To see Walumbe"
          ],
          "optionsLang": "target",
          "answer": 1
        },
        {
          "line": {
            "speaker": "jjajja",
            "target": "Death followed them to the earth. Since then, people die.",
            "base": "Walumbe n’abagoberera ku nsi. Okuva olwo, abantu bafa."
          }
        },
        {
          "line": {
            "speaker": "emma",
            "target": "Oh! What does this story teach us?",
            "base": "Ayi! Enfumo eno etuyigiriza ki?"
          }
        },
        {
          "line": {
            "speaker": "jjajja",
            "target": "It teaches us that we should listen to elders.",
            "base": "Etuyigiriza nti tuwulirize abakadde."
          }
        },
        {
          "question": "Jjajja awa ssomo ki?",
          "options": [
            "Listen to elders",
            "Wisdom beats strength",
            "Hurry home"
          ],
          "optionsLang": "target",
          "answer": 0
        },
        {
          "line": {
            "speaker": "emma",
            "target": "Thank you very much, Grandma!",
            "base": "Mwebale nnyo, Jjajja!"
          }
        }
      ]
    }
  ]
}
