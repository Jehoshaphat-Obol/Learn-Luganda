  "guidebook": {
    "intro": "Luganda has no “-er” or “-est”. Instead, things “surpass” each other with the verb **okusinga**.",
    "phrases": [
      { "target": "Enjovu nnene okusinga ente.", "base": "An elephant is bigger than a cow." },
      { "target": "Ani asinga obuwanvu?", "base": "Who is the tallest?" },
      { "target": "Kino kye kisinga obulungi.", "base": "This is the best one." },
      { "target": "Njagala matooke okusinga byonna.", "base": "I like matooke most of all." },
      { "target": "Si kye kimu!", "base": "It’s not the same!" },
      { "target": "Afaanana nga maama we.", "base": "She looks like her mother." }
    ],
    "tips": [
      {
        "id": "comparing",
        "title": "Surpassing",
        "body": [
          "For “bigger than”, say the adjective and add **okusinga** (to surpass): **Enjovu nnene okusinga ente**.",
          "For “the most”, the thing itself surpasses, in a quality noun: **asinga obuwanvu** (surpasses in height = the tallest), **ekisinga obulungi** (the one that surpasses in goodness = the best). Quality nouns start with **obu-**: **obunene** (size), **obuwanvu** (height), **obulungi** (goodness)."
        ],
        "table": [
          ["Adjective", "Quality", "The most …"],
          ["-nene (big)", "obunene", "asinga obunene"],
          ["-wanvu (tall)", "obuwanvu", "asinga obuwanvu"],
          ["-lungi (good)", "obulungi", "asinga obulungi"]
        ]
      }
    ],
    "culture": [
      {
        "title": "Modest comparisons",
        "body": [
          "Boasting that you are **asinga** at something can seem rude. People prefer to praise others: **Ggwe osinga!** (you’re the best!) is a warm compliment."
        ]
      }
    ]
  },
