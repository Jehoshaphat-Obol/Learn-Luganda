  "guidebook": {
    "intro": "Football is a passion across Uganda, music is everywhere, and there’s always a game of omweso under a tree somewhere.",
    "phrases": [
      { "target": "Nnyumirwa okusoma ebitabo.", "base": "I enjoy reading books." },
      { "target": "Nzannya omupiira ku Lwamukaaga.", "base": "I play football on Saturday." },
      { "target": "Ttiimu yange ewangudde!", "base": "My team has won!" },
      { "target": "Ani awangudde?", "base": "Who has won?" },
      { "target": "Nnyumirwa okuyimba n’okuzina.", "base": "I enjoy singing and dancing." },
      { "target": "Njagala ennyimba z’Oluganda.", "base": "I like Luganda songs." }
    ],
    "tips": [
      {
        "id": "enjoy",
        "title": "Saying what you like doing",
        "body": [
          "Put a **ku-** infinitive after **Nnyumirwa** (I enjoy) or **Njagala** (I like, I want): **Nnyumirwa okuwuga**.",
          "Join two activities with **n’** (and) before a vowel: **okuyimba n’okuzina**. Join two sentences with **era**: **Nsoma, era nzannya**."
        ]
      }
    ],
    "culture": [
      {
        "title": "The Cranes",
        "body": [
          "Uganda’s national football team is called the Cranes, after the crested crane. On big match nights, crowds gather around any TV to watch, and a goal brings shouts of **Goolo!** from every house."
        ]
      },
      {
        "title": "Omweso",
        "body": [
          "**Omweso** is a fast board game of four rows of pits and 64 seeds, related to games played all over Africa. Skilled players count and move seeds faster than you can follow."
        ]
      }
    ]
  },
