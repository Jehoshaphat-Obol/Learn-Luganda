  "guidebook": {
    "intro": "Respect is at the heart of Ganda manners. Greet elders kneeling, and speak to one elder as if to many: **Mwasuze mutya?**",
    "phrases": [
      { "target": "Mwasuze mutya, ssebo?", "base": "Good morning, sir." },
      { "target": "Mwebale nnyo, nnyabo.", "base": "Thank you very much, madam." },
      { "target": "Mwattu, mpa amazzi.", "base": "Please give me water." },
      { "target": "Webale okujja!", "base": "Thanks for coming!" },
      { "target": "Yingira otuule.", "base": "Come in and sit down." },
      { "target": "Tuula, olyeko.", "base": "Sit down and have some food." }
    ],
    "tips": [
      {
        "id": "kneeling",
        "title": "Kneeling to greet",
        "body": [
          "Women and children traditionally **fukamira** (kneel) when they greet elders, parents-in-law or important guests, and stay low until the greeting ends. Men may bow or crouch. In town it is lighter, but at home and at ceremonies it matters."
        ]
      },
      {
        "id": "respect-plural",
        "title": "The plural of respect",
        "body": ["To one elder, use the plural “you” (**mu-**) instead of the singular (**o-** / **w-**). It is like French *vous*."],
        "table": [
          ["To a friend", "To an elder", "English"],
          ["Wasuze otya?", "Mwasuze mutya?", "Good morning"],
          ["Webale", "Mwebale", "Thank you"],
          ["Ogenda wa?", "Mugenda wa?", "Where are you going?"]
        ]
      }
    ],
    "culture": [
      {
        "title": "The guest comes first",
        "body": [
          "**Omugenyi ye mukulu**: a guest is always offered a seat and something to eat or drink, even on a short visit. Saying no outright is impolite; taste a little and say **Mwebale**."
        ]
      }
    ]
  },
