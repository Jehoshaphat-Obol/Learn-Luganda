  "guidebook": {
    "intro": "Most animal names belong to the n- class, so the agreement you learnt for clothes works for animals too.",
    "phrases": [
      { "target": "Waliwo ebisolo bingi.", "base": "There are many animals." },
      { "target": "Nnina embuzi bbiri.", "base": "I have two goats." },
      { "target": "Ente zirya omuddo.", "base": "The cows eat grass." },
      { "target": "Enjovu nnene nnyo.", "base": "The elephant is very big." },
      { "target": "Ntya omusota!", "base": "I’m afraid of the snake!" },
      { "target": "Engaali ebuuka.", "base": "The crested crane is flying." }
    ],
    "tips": [
      {
        "id": "same-plural",
        "title": "One cow, many cows",
        "body": [
          "Many n- nouns are the same in the singular and the plural: **ente** is one cow or a herd. The words around the noun tell you which. **Ente erya** is “the cow eats”, **ente zirya** is “the cows eat”.",
          "**Waliwo** means “there is” or “there are”, for any noun: **Waliwo empologoma?** (Is there a lion?)."
        ],
        "table": [
          ["", "One", "Many"],
          ["eats", "ente erya", "ente zirya"],
          ["is here / are here", "embwa eri wano", "embwa ziri wano"],
          ["my", "embuzi yange", "embuzi zange"]
        ]
      }
    ],
    "culture": [
      {
        "title": "The crested crane",
        "body": [
          "The grey crowned crane, **engaali**, stands on Uganda’s flag and coat of arms. It mates for life and dances to court, which is why it is a symbol of the nation. (It is also our mascot’s inspiration.)"
        ]
      },
      {
        "title": "Cattle as wealth",
        "body": [
          "Cows have long meant wealth and status. They feature in bride price, in proverbs and in many clan totems you’ll meet in Section 4."
        ]
      }
    ]
  },
  "stories": [
    {
      "id": "village-farm",
      "title": "At Jjajja’s farm",
      "unlockAfter": "u13s3l3",
      "cast": ["emma", "jjajja"],
      "summary": "Emma visits the village and meets the animals.",
      "steps": [
        {
          "line": { "speaker": "jjajja", "target": "Tusanyuse okukulaba, Emma! Yingira.", "base": "We are happy to see you, Emma! Come in." }
        },
        {
          "line": { "speaker": "emma", "target": "Weebale, Jjajja. Ebisolo biri wa?", "base": "Thank you, Grandma. Where are the animals?" },
          "gloss": { "biri": "are (for ebi- nouns)" }
        },
        {
          "line": { "speaker": "jjajja", "target": "Laba! Ente zirya omuddo.", "base": "Look! The cows are eating grass." },
          "gloss": { "Laba": "look" }
        },
        { "question": "What are the cows doing?", "options": ["Sleeping", "Eating grass", "Drinking water"], "answer": 1 },
        { "line": { "speaker": "emma", "target": "Ente mmeka?", "base": "How many cows?" } },
        { "line": { "speaker": "jjajja", "target": "Ente ttaano n’embuzi kkumi.", "base": "Five cows and ten goats." } },
        { "question": "How many goats does Jjajja have?", "options": ["Five", "Two", "Ten"], "answer": 2 },
        { "line": { "speaker": "emma", "target": "Ayi! Omusota!", "base": "Oh! A snake!" } },
        {
          "line": { "speaker": "jjajja", "target": "Nedda, mwana wange. Ogwo muguwa.", "base": "No, my child. That is a rope." },
          "gloss": { "Ogwo": "that (for mu- nouns)", "muguwa": "a rope" }
        },
        { "question": "What did Emma really see?", "options": ["A rope", "A snake", "A dog"], "answer": 0 },
        { "line": { "speaker": "emma", "target": "Haha! Ntya omusota nnyo.", "base": "Haha! I’m really afraid of snakes." } },
        {
          "line": { "speaker": "jjajja", "target": "Laba waggulu: engaali ebuuka!", "base": "Look up: a crested crane is flying!" },
          "gloss": { "waggulu": "up, above" }
        },
        { "line": { "speaker": "emma", "target": "Nnungi nnyo!", "base": "It’s so beautiful!" } }
      ]
    }
  ]
}
