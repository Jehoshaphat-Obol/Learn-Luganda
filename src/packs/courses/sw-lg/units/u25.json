    "culture": [
      {
        "title": "Majina ya koo",
        "body": [
          "Majina mengi ya Kiganda ni ya ukoo fulani, kwa hiyo jina linaweza kuwaambia watu ukoo wako kabla hujausema. Buganda ina koo zaidi ya hamsini, kila moja ikiongozwa na mkuu wa ukoo, **omutaka**. Ni kama majina ya ukoo kwa Wachagga au Wakikuyu."
        ]
      }
