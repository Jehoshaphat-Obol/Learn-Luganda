      }
    ],
    "tips": [
      {
        "id": "weather-verbs",
        "title": "Hali ya hewa hutenda",
        "body": [
          "Maneno ya hali ya hewa ni majina yanayotenda, kama Kiswahili: mvua inanyesha (**enkuba etonnya**), jua linawaka (**omusana gwaka**). Kila kitenzi hukubaliana na jina lake, kama **i-** ya mvua na **li-** ya jua: **e-** kwa enkuba, **gu-** kwa omusana, **bu-** kwa obudde.",
          "**Obudde** maana yake hali ya hewa na wakati pia. **Obudde bulungi** ni “hali ya hewa ni nzuri”."
        ]
      },
      {
        "id": "seasons",
        "title": "Mvua na kiangazi",
        "body": [
          "**Ttoggo** ni masika, mvua ndefu, karibu Machi hadi Mei. **Ekyeya** ni kiangazi, wakati wa joto na vumbi. Kuna msimu wa pili wa mvua fupi baadaye mwakani, kama vuli."
        ]
      }
    ],
    "culture": [
      {
        "title": "Mvua husimamisha kila kitu",
        "body": [
          "Mvua kubwa Kampala inaweza kusimamisha magari na mikutano, na hakuna anayejali kusubiri ipite. “Mvua ilinichelewesha” ni sababu nzuri kabisa ya kuchelewa."
        ]
      }
    ]
  },
  "stories": [
    {
      "id": "rainy-day",
      "title": "Mchana wa mvua",
      "unlockAfter": "u12s3l3",
      "cast": [
        "amara",
        "jjajja"
      ],
      "summary": "Dhoruba inamzuia Amara nyumbani kwa bibi yake.",
      "steps": [
        {
          "line": {
            "speaker": "amara",
            "target": "Jjajja, ŋŋenda awaka.",
            "base": "Bibi, ninakwenda nyumbani."
          }
        },
        {
          "line": {
            "speaker": "jjajja",
            "target": "Nedda! Laba, ebire bingi. Enkuba ejja.",
            "base": "Hapana! Tazama, kuna mawingu mengi. Mvua inakuja."
          },
          "gloss": {
            "Laba": "tazama",
            "ejja": "inakuja"
          }
        },
        {
          "question": "Kwa nini Jjajja anasema hapana?",
          "options": [
            "Ni usiku sana",
            "Mvua inakuja",
            "Amara ni mgonjwa"
          ],
          "answer": 1
        },
        {
          "line": {
            "speaker": "amara",
            "target": "Naye omusana gwaka!",
            "base": "Lakini jua linawaka!"
          },
          "gloss": {
            "Naye": "lakini"
          }
        },
        {
          "line": {
            "speaker": "jjajja",
            "target": "Wuliriza… eggulu libwatuka.",
            "base": "Sikiliza… radi inapiga."
          },
          "gloss": {
            "Wuliriza": "sikiliza"
          }
        },
        {
          "line": {
            "speaker": "amara",
            "target": "Ayi! Enkuba etonnya nnyo nnyo!",
            "base": "Lo! Mvua inanyesha sana!"
          }
        },
        {
          "question": "Hali ya hewa iko vipi sasa?",
          "options": [
            "Jua na joto",
            "Mvua kubwa sana",
            "Baridi na ukavu"
          ],
          "answer": 1
        },
        {
          "line": {
            "speaker": "jjajja",
            "target": "Tuula wano. Mpulira empewo. Ggwe?",
            "base": "Kaa hapa. Ninahisi baridi. Na wewe?"
          }
        },
        {
          "line": {
            "speaker": "amara",
            "target": "Nange. Njagala caayi.",
            "base": "Mimi pia. Ninataka chai."
          },
          "gloss": {
            "Nange": "mimi pia, nami"
          }
        },
        {
          "line": {
            "speaker": "jjajja",
            "target": "Kale, tunywe caayi. Oluvannyuma, twala ekiwempe kyange.",
            "base": "Sawa, tunywe chai. Baadaye, chukua mwavuli wangu."
          }
        },
        {
          "question": "Amara atachukua nini kwenda nyumbani?",
          "options": [
            "Mwavuli wa Jjajja",
            "Sweta",
            "Chakula kidogo"
          ],
          "answer": 0
        },
        {
          "line": {
            "speaker": "amara",
            "target": "Weebale nnyo, Jjajja!",
            "base": "Asante sana, Bibi!"
          }
        }
      ]
    }
  ]
