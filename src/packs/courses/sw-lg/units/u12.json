  "guidebook": {
    "intro": "Uganda iko kwenye ikweta, kwa hiyo mwaka hupangwa na mvua badala ya kiangazi na baridi, kama sehemu kubwa ya Afrika Mashariki.",
    "phrases": [
      {
        "target": "Enkuba etonnya.",
