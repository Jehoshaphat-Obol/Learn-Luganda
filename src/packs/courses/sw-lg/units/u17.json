  "guidebook": {
    "intro": "Kukataa kwa adabu ni hatua kubwa kuelekea mazungumzo halisi. Kiganda hukifanya kitenzi kuwa hasi kwa kiambishi kidogo, kama Kiswahili, na hata kiambishi cha kwanza ni kilekile: **si-**.",
    "phrases": [
      {
        "target": "Saagala kaawa.",
        "base": "Sitaki kahawa."
      },
      {
        "target": "Sirya nnyama.",
        "base": "Sili nyama."
      },
      {
        "target": "Simanyi, ssebo.",
        "base": "Sijui, bwana."
      },
      {
        "target": "Sitegeera. Ddamu.",
        "base": "Sielewi. Rudia."
      },
      {
        "target": "Sirina ssente.",
        "base": "Sina pesa."
      },
      {
        "target": "Tewali mazzi.",
