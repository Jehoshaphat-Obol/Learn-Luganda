  "guidebook": {
    "intro": "Chakula ndicho kitovu cha ukarimu wa Waganda. Mlo ni chakula kikuu pamoja na mchuzi, na mgeni hukaribishwa kula kila mara.",
    "phrases": [
      {
        "target": "Nnina enjala.",
