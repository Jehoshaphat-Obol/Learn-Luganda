  "guidebook": {
    "intro": "Hadithi za Kiganda (**enfumo**) husimuliwa jioni. Mbili maarufu zaidi ni hila za **Wakayima** sungura, na hekaya ya **Kintu**, mtu wa kwanza.",
    "phrases": [
      {
        "target": "Wakayima yali mugezi nnyo.",
        "base": "Sungura alikuwa mjanja sana."
      },
      {
        "target": "Wakayima yalimba enjovu.",
        "base": "Sungura alimdanganya tembo."
      },
      {
        "target": "Kintu ye muntu eyasooka.",
        "base": "Kintu alikuwa mtu wa kwanza."
      },
      {
        "target": "Nnambi yeerabira obulo bw’enkoko.",
        "base": "Nnambi alisahau mtama wa kuku."
      },
      {
        "target": "Enfumo eno etuyigiriza ki?",
        "base": "Hadithi hii inatufundisha nini?"
      },
      {
        "target": "Etuyigiriza nti obugezi businga amaanyi.",
        "base": "Inatufundisha kwamba busara hushinda nguvu."
      }
    ],
    "tips": [
      {
        "id": "wakayima",
        "title": "Wakayima mjanja",
        "body": [
          "Sungura mdogo huwashinda wanyama wakubwa kwa ujanja: humdanganya tembo, simba na chui, sawa kabisa na Sungura wa hadithi za Kiswahili. Funzo kwa kawaida ni **obugezi businga amaanyi** (busara hushinda nguvu), ingawa wakati mwingine Wakayima hunaswa na uongo wake mwenyewe.",
          "Angalia **businga**: ni **okusinga** (kushinda) wa Kipengele 33, ukifuata ngeli ya **obu-** ya **obugezi** (busara)."
        ]
      },
      {
        "id": "kintu-legend",
        "title": "Kintu na Nnambi",
        "body": [
          "**Kintu** aliishi peke yake na ng’ombe wake hadi **Nnambi**, binti wa **Ggulu** (mbingu), alipoolewa naye. Ggulu aliwaambia waondoke haraka kabla kaka yake **Walumbe** (Kifo) hajawafuata.",
          "Njiani, Nnambi alirudi kuchukua mtama aliokuwa amesahau kwa ajili ya kuku wake. **Walumbe** akamfuata, na ndiyo sababu kifo kilikuja duniani."
        ]
      }
    ],
    "culture": [
      {
        "title": "Kusimulia upya",
        "body": [
          "Msimuliaji mzuri hufungua kwa **Olwatuuka olwali olumu**, huwafanya wasikilizaji wajibu, na humaliza kwa funzo: **Enfumo eno etuyigiriza nti…** (hadithi hii inatufundisha kwamba…). Sasa nawe unaweza kusimulia moja. Hongera kwa kufika kipengele cha mwisho!"
        ]
      }
    ]
  },
  "stories": [
    {
      "id": "kintu-and-nnambi",
      "title": "Kintu na Nnambi",
      "unlockAfter": "u40s3l3",
      "cast": [
        "jjajja",
        "emma"
      ],
      "summary": "Jjajja anamsimulia Emma hekaya ya jinsi kifo kilivyokuja duniani.",
      "steps": [
        {
          "line": {
            "speaker": "emma",
            "target": "Jjajja, mpulira nti waliwo enfumo ya Kintu. Ngerera!",
            "base": "Bibi, nasikia kuna hadithi kuhusu Kintu. Nisimulie!"
          }
        },
        {
          "line": {
            "speaker": "jjajja",
            "target": "Kale. Olwatuuka olwali olumu, Kintu ye muntu eyasooka. Yabeeranga yekka n’ente ye.",
            "base": "Basi. Hapo zamani za kale, Kintu alikuwa mtu wa kwanza. Aliishi peke yake na ng’ombe wake."
          },
          "gloss": {
            "yekka": "peke yake"
          }
        },
        {
          "line": {
            "speaker": "jjajja",
            "target": "Awo Nnambi, muwala wa Ggulu, n’amwagala. Kintu n’amuwasa.",
            "base": "Kisha Nnambi, binti wa Ggulu, akampenda. Kintu akamwoa."
          }
        },
        {
          "question": "Nnambi alikuwa nani?",
          "options": [
            "Binti wa Ggulu",
            "Dada yake Kintu",
            "Sungura mjanja"
          ],
          "answer": 0
        },
        {
          "line": {
            "speaker": "jjajja",
            "target": "Ggulu n’agamba nti: “Mugende mangu, Walumbe aleme okubagoberera.”",
            "base": "Ggulu akasema: “Nendeni haraka, ili Kifo kisiwafuate.”"
          },
          "gloss": {
            "aleme": "ili asi-"
          }
        },
        {
          "line": {
            "speaker": "jjajja",
            "target": "Naye mu kkubo, Nnambi yeerabira obulo bw’enkoko. N’addayo.",
            "base": "Lakini njiani, Nnambi alisahau mtama wa kuku. Akarudi."
          }
        },
        {
          "question": "Kwa nini Nnambi alirudi?",
          "options": [
            "Kwa ajili ya ng’ombe wake",
            "Kwa ajili ya mtama wa kuku",
            "Kumwona Walumbe"
          ],
          "answer": 1
        },
        {
          "line": {
            "speaker": "jjajja",
            "target": "Walumbe n’abagoberera ku nsi. Okuva olwo, abantu bafa.",
            "base": "Kifo kikawafuata hadi duniani. Tangu hapo, watu hufa."
          },
          "gloss": {
            "ku nsi": "duniani"
          }
        },
        {
          "line": {
            "speaker": "emma",
            "target": "Ayi! Enfumo eno etuyigiriza ki?",
            "base": "Lo! Hadithi hii inatufundisha nini?"
          }
        },
        {
          "line": {
            "speaker": "jjajja",
            "target": "Etuyigiriza nti tuwulirize abakadde.",
            "base": "Inatufundisha kwamba tuwasikilize wazee."
          }
        },
        {
          "question": "Jjajja anatoa funzo gani?",
          "options": [
            "Wasikilize wazee",
            "Busara hushinda nguvu",
            "Rudi nyumbani haraka"
          ],
          "answer": 0
        },
        {
          "line": {
            "speaker": "emma",
            "target": "Mwebale nnyo, Jjajja!",
            "base": "Asante sana, Bibi!"
          }
        }
      ]
    }
  ]
}
