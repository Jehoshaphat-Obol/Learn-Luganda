  "guidebook": {
    "intro": "Sherehe za Waganda ni kubwa, za rangi nyingi na ndefu. Kwanjula, ambapo wachumba wanatambulishwa kwa familia ya bibi harusi, ni mojawapo ya muhimu zaidi.",
    "phrases": [
      {
        "target": "Kwanjula eri ku Lwamukaaga.",
