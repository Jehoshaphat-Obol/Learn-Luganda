  "guidebook": {
    "intro": "Kuzungumza kuhusu wakati ujao hukuwezesha kupanga mipango, kuahidi na kuota ndoto. Kiganda kina wakati ujao wa karibu na wa mbali, wakati Kiswahili kina **-ta-** moja tu.",
    "phrases": [
      {
        "target": "Enkya nja kugenda e Masaka.",
        "base": "Kesho nitakwenda Masaka."
      },
      {
        "target": "Tujja kusoma awamu.",
        "base": "Tutasoma pamoja."
      },
      {
        "target": "Oteekateeka ki ku wiikendi?",
        "base": "Unapanga nini wikendi?"
      },
      {
        "target": "Ku wiikendi nja kukyalira jjajja.",
        "base": "Wikendi nitamtembelea bibi."
      },
      {
        "target": "Olunaku lumu ndyogera Oluganda bulungi.",
        "base": "Siku moja nitazungumza Kiganda vizuri."
      },
      {
        "target": "Nsuubira okulaba Kabaka.",
        "base": "Natumaini kumwona Kabaka."
      }
    ],
    "tips": [
      {
        "id": "near-future",
        "title": "Karibuni: ja + ku-",
        "body": [
          "Wakati ujao wa karibu hutumia **-jja** (kuja) pamoja na umbo la **ku-**, kama Kiswahili cha mazungumzo “ninakuja kufanya”: **nja kugenda** (nitakwenda), **ojja kugenda** (utakwenda), **ajja kugenda** (atakwenda), **tujja kugenda** (tutakwenda), **bajja kugenda** (watakwenda).",
          "**o-** ya kitenzi-jina hudondoka: **okulya** huwa **kulya** baada ya **nja**, kama Kiswahili **kula**."
        ]
      },
      {
        "id": "far-future",
        "title": "Siku moja: li-",
        "body": [
          "Kwa wakati ujao wa mbali au usio na uhakika, ongeza **-li-**: **ndigenda** (nitakwenda, siku moja), **ndyogera** (nitazungumza). Iunganishe na **olunaku lumu** (siku moja). Tahadhari: **-li-** ya Kiswahili ni wakati uliopita, lakini **-li-** ya Kiganda ni wakati ujao!"
        ]
      }
    ],
    "culture": [
      {
        "title": "Mipango na “Katonda bw’anaayagala”",
        "body": [
          "Waganda wengi huongeza **Katonda bw’anaayagala** (Mungu akipenda) wanapozungumza kuhusu wakati ujao, kama “Inshallah” ya Kiswahili. Utaisikia mwishoni mwa mipango ya kila aina."
        ]
      }
    ]
  },
  "stories": [
    {
      "id": "weekend-plans",
      "title": "Mipango ya wikendi",
      "unlockAfter": "u20s3l3",
      "cast": [
        "ssali",
        "nakato"
      ],
      "summary": "Ssali na Nakato wanazungumza kuhusu wikendi iliyopita na ijayo.",
      "steps": [
        {
          "line": {
            "speaker": "ssali",
            "target": "Nakato! Wiikendi ewedde wakola ki?",
            "base": "Nakato! Ulifanya nini wikendi iliyopita?"
          }
        },
        {
          "line": {
            "speaker": "nakato",
            "target": "Nnagenda e Masaka okukyalira maama.",
            "base": "Nilikwenda Masaka kumtembelea mama yangu."
          }
        },
        {
          "question": "Nakato alikwenda wapi wikendi iliyopita?",
          "options": [
            "Jinja",
            "Masaka",
            "Entebbe"
          ],
          "answer": 1
        },
        {
          "line": {
            "speaker": "ssali",
            "target": "Kirungi! Ate ku wiikendi eno?",
            "base": "Vizuri! Na wikendi hii je?"
          }
        },
        {
          "line": {
            "speaker": "nakato",
            "target": "Simanyi. Oteekateeka ki ggwe?",
            "base": "Sijui. Wewe unapanga nini?"
          }
        },
        {
          "line": {
            "speaker": "ssali",
            "target": "Nja kugenda ku nnyanja e Entebbe. Ojja?",
            "base": "Nitakwenda ziwani Entebbe. Utakuja?"
          },
          "gloss": {
            "nnyanja": "ziwa"
          }
        },
        {
          "question": "Mpango wa Ssali ni upi?",
          "options": [
            "Kwenda ziwani",
            "Kumtembelea mama yake",
            "Kusoma nyumbani"
          ],
          "answer": 0
        },
        {
          "line": {
            "speaker": "nakato",
            "target": "Yee! Naye sirina ssente nnyingi.",
            "base": "Ndiyo! Lakini sina pesa nyingi."
          }
        },
        {
          "line": {
            "speaker": "ssali",
            "target": "Totya. Tujja kugenda mu mmotoka yange.",
            "base": "Usijali. Tutakwenda kwa gari langu."
          }
        },
        {
          "question": "Ssali anasemaje “Tutakwenda”?",
          "options": [
            "Tujja kugenda",
            "Twagenda",
            "Togenda"
          ],
          "answer": 0,
          "optionsLang": "target"
        },
        {
          "line": {
            "speaker": "nakato",
            "target": "Weebale nnyo! Tunaalabagana ku Lwamukaaga.",
            "base": "Asante sana! Tutaonana Jumamosi."
          }
        }
      ]
    }
  ]
