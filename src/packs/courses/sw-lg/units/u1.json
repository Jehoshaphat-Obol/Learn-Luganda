  "guidebook": {
    "intro": "Salamu ndizo moyo wa mazungumzo Buganda. Hakuna anayeuliza njia au kununua embe kabla ya kusalimia kwanza. Kama Waswahili, Waganda hawaanzi jambo bila salamu.",
    "phrases": [
      {
        "target": "Oli otya?",
        "base": "Habari yako?"
      },
      {
        "target": "Gyendi, weebale.",
        "base": "Nzuri, asante."
      },
      {
        "target": "Wasuze otya?",
        "base": "Habari za asubuhi (ulilalaje?)"
      },
      {
        "target": "Nsuze bulungi.",
        "base": "Nimelala salama."
      },
      {
        "target": "Osiibye otya?",
        "base": "Habari za mchana (umeshindaje?)"
      },
      {
        "target": "Gyebale ko!",
        "base": "Pole na kazi! (kwa mtu anayefanya kazi)"
      },
      {
        "target": "Erinnya lyo ani?",
        "base": "Jina lako ni nani?"
      },
      {
        "target": "Nze Nakato.",
        "base": "Mimi ni Nakato."
      },
      {
        "target": "Nva Masaka.",
