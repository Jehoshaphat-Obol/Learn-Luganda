    "new-gomesi": {
      "title": "Gomesi ya sherehe",
      "summary": "Nakato anatafuta nguo ya kuvaa kwenye kwanjula ya binamu yake.",
      "lines": [
        "Habari, mama! Unataka nini?",
        "Ninataka gomesi. Kuna kwanjula Jumamosi.",
        "Gomesi hii ni ya zambarau. Ni nzuri sana!",
        "Hapana, ninataka nyekundu.",
        "Sawa. Hii hapa nyekundu. Ijaribu!",
        "Hii ni ndogo. Kuna kubwa?",
        "Ndiyo, hii ni kubwa. Elfu hamsini.",
        "Ni ghali sana! Punguza bei kidogo.",
        "Sawa, elfu arobaini.",
        "Sawa, nitaichukua. Asante sana!"
      ],
      "questions": [
        { "question": "Kwanjula ni lini?", "options": ["Jumatatu", "Jumamosi", "Leo"] },
        { "question": "Nakato anataka rangi gani?", "options": ["Zambarau", "Nyekundu", "Nyeupe"] },
        { "question": "Gomesi nyekundu ina tatizo gani?", "options": ["Ni ndogo mno", "Ni ghali mno", "Ni kuukuu"] },
        { "question": "Nakato anasemaje “Sawa, nitaichukua”?" }
      ]
    }
