  "sentences": {
    "s21-nsanyuse-nnyo": { "text": "Leo nimefurahi sana!", "alts": ["Nimefurahi sana leo!", "Leo nina furaha sana!"] },
    "s21-lwaki-onakuwadde": { "text": "Kwa nini una huzuni?", "alts": ["Mbona una huzuni?", "Kwa nini umehuzunika?"] },
