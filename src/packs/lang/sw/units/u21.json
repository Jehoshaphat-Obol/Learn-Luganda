    "s21-nneewuunya": { "text": "Nimeshangaa! Unakuja leo?", "alts": ["Nimeshangaa! Utakuja leo?"] },
    "s21-nkooye-nnyo": { "text": "Nimechoka sana. Nitalala.", "alts": ["Nimechoka sana. Nitakwenda kulala."] },
    "s21-ntidde": { "text": "Ninaogopa, radi inapiga.", "alts": ["Naogopa, radi inapiga.", "Ninaogopa, kuna radi."] },
    "s21-nneeraliikirira": { "text": "Nina wasiwasi kuhusu mtihani.", "alts": ["Ninahangaika kuhusu mtihani."] },
    "s21-nnyiize": { "text": "Nimekasirika kwa sababu teksi haikuja.", "alts": ["Nina hasira kwa sababu teksi haikuja."] },
    "s21-maama-ali-atya": { "text": "Mama yako hajambo?", "alts": ["Mama yako yuko vipi?", "Habari ya mama yako?", "Mama yako anaendeleaje?"] },
    "s21-bambi": { "text": "Pole sana! Pona haraka.", "alts": ["Pole! Pona haraka.", "Pole sana! Upone haraka."] },
    "s21-nsonyiwa": { "text": "Nisamehe, nimechelewa.", "alts": ["Samahani, nimechelewa.", "Unisamehe, nimechelewa."] },
    "s21-nkwagala-maama": { "text": "Nakupenda sana, Mama.", "alts": ["Ninakupenda sana, Mama."] },
    "s21-nkusubwa": { "text": "Nimekukumbuka, rafiki yangu.", "alts": ["Nakukumbuka, rafiki yangu."] },
