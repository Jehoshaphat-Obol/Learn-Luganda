  "sentences": {
    "s39-bafukamira": {
      "text": "Watoto hupiga magoti wanapowasalimia wazee.",
      "alts": ["Watoto hupiga magoti wakiwasalimia wazee.", "Watoto wanapiga magoti wanapowasalimu wazee."]
    },
    "s39-mwasuze-ssebo": { "text": "Habari za asubuhi, bwana.", "alts": ["Mmeamkaje, bwana?", "Shikamoo, mzee.", "Habari za asubuhi, mzee."] },
    "s39-mwebale-nnyabo": { "text": "Asanteni sana, mama.", "alts": ["Asante sana, mama.", "Ahsanteni sana, mama."] },
    "s39-ekitiibwa": { "text": "Lazima tuwape wazee heshima.", "alts": ["Lazima tuwaheshimu wazee.", "Tunapaswa kuwaheshimu wazee."] },
    "s39-mwattu": { "text": "Tafadhali nipe maji.", "alts": ["Naomba maji tafadhali.", "Nipe maji, tafadhali."] },
    "s39-webale-okujja": { "text": "Asanteni kwa kuja! Tumefurahi kuwaona.", "alts": ["Asante kwa kuja! Tumefurahi kukuona.", "Karibuni! Tumefurahi kuwaona."] },
    "s39-omugenyi": { "text": "Mgeni ndiye mkubwa.", "alts": ["Mgeni ndiye wa kwanza.", "Mgeni ni mfalme.", "Mgeni ndiye muhimu."] },
    "s39-olyeko": { "text": "Keti ule chakula.", "alts": ["Kaa ule chakula.", "Keti, karibu chakula.", "Kaa ule kidogo."] },
    "s39-yingira-otuule": { "text": "Karibu ndani uketi.", "alts": ["Ingia ukae.", "Karibu ndani, keti.", "Karibu ukae."] },
    "s-heshima": { "text": "Heshima ni muhimu sana." },
    "s-adabu": { "text": "Mtoto huyu ana adabu." },
    "s-hodi": { "text": "Hodi! Karibu!" },
    "s-mkono-kulia": { "text": "Kula kwa mkono wa kulia." },
    "s-ukarimu": { "text": "Asante kwa ukarimu wako." },
    "s-karibu-tena": { "text": "Asante, karibu tena!" }
  },
  "phrases": [
    "Habari za asubuhi, bwana.",
