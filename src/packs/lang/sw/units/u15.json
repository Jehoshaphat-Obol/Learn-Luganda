    "s15-ekibiina-kyaffe": { "text": "Darasa letu ni kubwa." },
    "s15-mpa-ekkalaamu": { "text": "Nipe kalamu, mwalimu.", "alts": ["Nipe kalamu, mama.", "Nipatie kalamu, mama."] },
    "s15-mpandiika-ebigambo": { "text": "Ninaandika maneno kwenye karatasi.", "alts": ["Naandika maneno kwenye karatasi.", "Ninaandika maneno karatasini."] },
    "s15-musome-ekitabo": { "text": "Someni kitabu.", "alts": ["Someni kitabu nyote.", "Msome kitabu."] },
    "s15-muwandiike-erinnya": { "text": "Andikeni majina yenu.", "alts": ["Andikeni majina yenu nyote.", "Mwandike majina yenu."] },
    "s15-muwulirize": { "text": "Msikilizeni mwalimu.", "alts": ["Sikilizeni mwalimu.", "Msikilize mwalimu."] },
    "s15-nsoma-olungereza": { "text": "Ninasoma Kiingereza na Kiganda.", "alts": ["Nasoma Kiingereza na Kiganda.", "Ninajifunza Kiingereza na Kiganda."] },
    "s15-nnyagala-nnyo-okubala": { "text": "Ninapenda sana hisabati.", "alts": ["Napenda sana hisabati.", "Ninapenda hesabu sana."] },
    "s15-ssaayansi-nzibu": { "text": "Sayansi ni ngumu." },
    "s15-nnina-ekibuuzo": { "text": "Nina swali." },
    "s15-otegeera": { "text": "Unaelewa? Ndiyo, ninaelewa.", "alts": ["Umeelewa? Ndiyo, nimeelewa.", "Unaelewa? Ndiyo, naelewa."] },
    "s15-ddamu-mpola": { "text": "Rudia polepole, mwalimu.", "alts": ["Rudia polepole, bwana.", "Sema tena polepole, bwana."] },
    "s15-omulimu-gwawaka": { "text": "Ninafanya kazi ya nyumbani.", "alts": ["Nafanya kazi ya nyumbani."] },
    "s15-ekigezo-enkya": { "text": "Mtihani ni kesho." }
  },
  "phrases": ["Someni kitabu.", "Msikilizeni mwalimu.", "Nina swali.", "Unaelewa?", "Rudia polepole, mwalimu.", "Ninapenda sana hisabati."],
