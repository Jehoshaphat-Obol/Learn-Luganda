  "stories": {
    "the-kwanjula": {
      "title": "Utambulisho",
      "summary": "Nakato anajiandaa kwa kwanjula ya binamu yake pamoja na Jjajja.",
      "lines": [
        "Nakato, umevaa gomesi yako?",
        "Ndiyo, Bibi. Ni nzuri?",
        "Nzuri sana! Zawadi iko wapi?",
        "Iko hapa. Sukari na chumvi.",
        "Vizuri. Shangazi anamsaidia bibi harusi.",
        "Wageni ni wengi sana!",
        "Ndiyo. Leo tunasherehekea.",
        "Hongera, bibi harusi! Ninakutakia maisha mema!",
        "Tusherehekee! Asanteni nyote kwa kuja!"
      ],
      "questions": [
        { "question": "Nakato analeta zawadi gani?", "options": ["Keki", "Sukari na chumvi", "Jembe"] },
        { "question": "Nani anamsaidia bibi harusi katika kwanjula?", "options": ["Ssenga", "Kabaka", "Mwalimu"] },
        { "question": "Nakato anasemaje “ninakutakia”?" }
      ]
    }
  }
