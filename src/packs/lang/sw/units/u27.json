  "sentences": {
    "s27-olusuku-lwange": { "text": "Shamba langu la migomba ni kubwa.", "alts": ["Shamba langu ni kubwa.", "Shamba langu la ndizi ni kubwa."] },
    "s27-ndima-n-enkumbi": { "text": "Ninalima kwa jembe asubuhi.", "alts": ["Nalima kwa jembe asubuhi.", "Asubuhi ninalima kwa jembe."] },
    "s27-okusiga-ensigo": { "text": "Tunapanda mbegu wakati wa mvua.", "alts": ["Tunapanda mbegu msimu wa mvua.", "Tunapanda mbegu masika."] },
    "s27-kasooli": { "text": "Mahindi yamekua vizuri.", "alts": ["Mahindi yamestawi vizuri."] },
    "s27-ebinyeebwa": { "text": "Ninauza karanga na mahindi.", "alts": ["Nauza karanga na mahindi.", "Ninauza njugu na mahindi."] },
    "s27-emmwanyi": { "text": "Kahawa ya Buganda ni nzuri sana.", "alts": ["Kahawa ya Buganda ni bora sana."] },
    "s27-amakungula": { "text": "Mavuno yamefika!", "alts": ["Wakati wa mavuno umefika!", "Mavuno yamewadia!"] },
    "s27-okukungula": { "text": "Kesho tutavuna karanga.", "alts": ["Tutavuna karanga kesho.", "Kesho tutavuna njugu."] },
    "s27-ndimira-jjajja": {
      "text": "Ninamlimia bibi shamba.",
      "alts": ["Ninamlimia babu shamba.", "Ninamlimia bibi shamba la migomba.", "Ninalimia bibi shamba."]
    },
    "s27-nfumbira-abaana": { "text": "Ninawapikia watoto chakula.", "alts": ["Nawapikia watoto chakula.", "Ninawapikia watoto."] },
    "s27-ntundira-mu-katale": { "text": "Ninauzia kahawa sokoni.", "alts": ["Nauza kahawa sokoni.", "Ninauza kahawa sokoni."] },
    "s27-mpandiikira-maama": { "text": "Ninamwandikia mama ujumbe.", "alts": ["Namwandikia mama ujumbe.", "Ninamwandikia mama yangu ujumbe."] },
    "s-mpunga": { "text": "Mpunga unapenda maji mengi." },
    "s-kupanda-mbegu": { "text": "Leo tutapanda mbegu." },
    "s-mavuno-mazuri": { "text": "Mavuno ni mazuri mwaka huu." },
    "s-jembe": { "text": "Chukua jembe." },
    "s-maji-ya-mvua": { "text": "Tunahifadhi maji ya mvua." }
