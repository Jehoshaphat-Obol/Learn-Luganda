      "title": "Picha ya familia",
      "summary": "Neema anamwonyesha Emma picha ya familia yake.",
      "lines": [
        "Huyu ni nani?",
        "Huyu ni bibi yangu, na huyu ni babu.",
        "Bibi yako ni mzuri! Una kaka?",
        "Ndiyo, nina kaka. Sina dada.",
        "Kaka yangu ni mrefu sana!",
        "Familia yako ni nzuri.",
        "Asante sana!"
      ],
      "questions": [
        { "question": "Nani yuko kwenye picha kwanza?", "options": ["Bibi yake Neema", "Mwalimu wa Neema", "Dada yake Neema"] },
