  "sentences": {
    "s36-olugero-luno": { "text": "Methali hii inamaanisha nini?", "alts": ["Maana ya methali hii ni nini?", "Methali hii ina maana gani?"] },
    "s36-jjajja-amanyi-engero": { "text": "Bibi anajua methali nyingi.", "alts": ["Babu anajua methali nyingi.", "Bibi yangu anajua methali nyingi."] },
    "s36-amakulu": { "text": "Ninataka kujua maana.", "alts": ["Nataka kujua maana.", "Ningependa kujua maana yake."] },
    "s36-kitegeeza-okwegatta": { "text": "Inamaanisha umoja ni nguvu.", "alts": ["Maana yake ni kwamba umoja ni nguvu.", "Inamaanisha kwamba umoja ni nguvu."] },
    "s36-kamu-kamu": {
      "text": "Kama wasemavyo, haba na haba hujaza kibaba.",
      "alts": ["Kama wanavyosema, haba na haba hujaza kibaba.", "Wahenga walisema, haba na haba hujaza kibaba."]
    },
    "s36-akwata-mpola": {
      "text": "Usijali. Polepole ndio mwendo.",
      "alts": ["Usiwe na wasiwasi. Polepole ndio mwendo.", "Usijali. Anayekwenda polepole hufika mbali."]
    },
    "s36-agali-awamu": {
      "text": "Tufanye kazi pamoja! Meno yaliyo pamoja huuma nyama.",
      "alts": ["Tufanye kazi pamoja! Umoja ni nguvu.", "Tushirikiane! Meno yaliyo pamoja huuma nyama."]
    },
    "s36-olugalo-olumu": { "text": "Nisaidie. Kidole kimoja hakivunji chawa.", "alts": ["Nisaidie. Kidole kimoja hakiui chawa."] }
  },
