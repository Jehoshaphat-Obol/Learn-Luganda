  "stories": {
    "jjajjas-advice": {
      "title": "Ushauri wa Jjajja",
      "summary": "Ssali hana subira na biashara yake mpya, na Jjajja anamjibu kwa methali.",
      "lines": [
        "Bibi, biashara yangu haiendi vizuri. Wateja ni wachache.",
        "Usijali, mwanangu. Polepole ndio mwendo.",
        "Inamaanisha nini?",
        "Inamaanisha: kuwa na subira. Haba na haba hujaza kibaba.",
        "Lakini ninafanya kazi peke yangu. Nimechoka.",
        "Kidole kimoja hakivunji chawa! Fanya kazi na Nakato.",
        "Wazo zuri. Meno yaliyo pamoja huuma nyama!",
        "Haha! Sasa unaongea kama bibi!"
      ],
      "questions": [
        { "question": "Ushauri wa Jjajja ni upi?", "options": ["Kuwa na subira", "Funga duka", "Hamia Jinja"] },
        { "question": "Methali gani inamwambia Ssali afanye kazi na wengine?" }
      ]
    }
  }
