    "new-gomesi": {
      "title": "Gomesi ey’omukolo",
      "summary": "{@nakato} agula ekyokwambala ku kwanjula kwa muganda we.",
      "lines": [
        "Gyebale ko, nyabo! Oyagala ki?",
        "Njagala gomesi. Waliwo kwanjula ku Lwamukaaga.",
        "Gomesi eno ya kakobe. Nungi inho!",
        "Nedda, njagala emyufu.",
        "Kale. Eno emyufu. Yambala!",
        "Eno ntono. Waliwo enene?",
        "Ee, eno nene. Emitwalo etaano.",
        "Ya beeyi inho! Kendeezaako.",
        "Kale, emitwalo ena.",
        "Kale, ngitwala. Weebale inho!"
      ],
      "questions": [
        { "question": "Okwanjula kuli di?", "options": ["Ku Balaza", "Ku Lwomukaaga", "Lero"] },
        { "question": "{@nakato} ayagala langi ki?", "options": ["Kakobe", "Myufu", "Njeru"] },
        { "question": "Gomesi emyufu erina buzibu ki?", "options": ["Etono inho", "Ya beeyi inho", "Nkade"] },
        { "question": "Mu Lungereza ogamba otya “Kale, ngitwala”?", "options": ["Kale, ngitwala.", "Yambula engato.", "Mpulira empewo."] }
      ]
