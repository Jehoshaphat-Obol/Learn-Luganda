    "new-gomesi": {
      "title": "Omushanana gw'obugyenyi",
      "summary": "{@nakato} naagura eky'okujwara aha kwanjura kwa mwene wabo.",
      "lines": [
        "Webale kukora, nyabo! Noyenda ki?",
        "Ninyenda omushanana. Hariho okwanjura aha Orwamukaaga.",
        "Omushanana ogu ni gwa kakobe. Ni murungi munonga!",
        "Ngaaha, ninyenda ogutukura.",
        "Kare. Ogutukura nigwo ogu. Geragyeza!",
        "Ogu ni mukye. Hariho ohango?",
        "Ego, ogu ni muhango. Emitwaro etaano.",
        "Nigugura munonga! Kyendeezeho.",
        "Kare, emitwaro ena.",
        "Kare, ningutwara. Webale munonga!"
      ],
      "questions": [
        { "question": "Okwanjura kuri ryari?", "options": ["Aha Orwokubanza", "Aha Orwamukaaga", "Erizooba"] },
        { "question": "{@nakato} naayenda rangi ki?", "options": ["Kakobe", "Kitukura", "Kyera"] },
        { "question": "Omushanana ogutukura guine buzibu ki?", "options": ["Ni mukye munonga", "Nigugura munonga", "Ni mukuru"] },
        {
          "question": "{@nakato} naagamba ata “Kare, ningitwara”?",
