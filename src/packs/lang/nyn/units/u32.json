  "stories": {
    "source-of-nile": {
      "title": "Enturukiro ya Kiyira",
      "summary": "{@ssali} naatwara {@emma} kureeba ahu Kiyira etandikira.",
      "lines": [
        "Twahika {@getaway}! Reeba, Kiyira.",
        "Kiyira netandikira nkahi?",
        "Hanu! Amaizi nigaruga omu Nalubaale.",
        "Ekinyonyi ekyo niki?",
        "Egyo n'entuuha! Neeguruka aiguru y'omugyera.",
        "Ebimuri n'emiti ni birungi munonga hanu.",
        "Ego. Kwonka reeba, ebisaasiro aha rubaju rw'amaizi.",
        "Turinde eitaka ryaitu! Tukonkomere ebisaasiro.",
        "Kirungi munonga, {@emma}!"
      ],
      "questions": [
        { "question": "Amaizi ga Kiyira nigaruga nkahi?", "options": ["Omu Nalubaale", "Omu kibira", "Omu njura yonka"] },
