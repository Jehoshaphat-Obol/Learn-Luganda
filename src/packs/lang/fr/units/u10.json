    "new-gomesi": {
      "title": "Une gomesi pour la fête",
      "summary": "{@nakato} cherche une tenue pour l’introduction de sa cousine.",
      "lines": [
        "Bonjour, madame ! Que voulez-vous ?",
        "Je veux une gomesi. Il y a une introduction samedi.",
        "Cette gomesi est violette. Elle est très jolie !",
        "Non, j’en veux une rouge.",
        "D’accord. En voici une rouge. Essayez-la !",
        "Celle-ci est petite. Il y en a une grande ?",
        "Oui, celle-ci est grande. Cinquante mille.",
        "C’est très cher ! Baissez un peu le prix.",
        "D’accord, quarante mille.",
        "D’accord, je la prends. Merci beaucoup !"
      ],
      "questions": [
        { "question": "Quand a lieu l’introduction ?", "options": ["Lundi", "Samedi", "Aujourd’hui"] },
        { "question": "Quelle couleur {@nakato} veut-elle ?", "options": ["Violet", "Rouge", "Blanc"] },
