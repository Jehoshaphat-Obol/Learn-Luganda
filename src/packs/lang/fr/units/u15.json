  "sentences": {
    "s15-ekibiina-kyaffe": { "text": "Notre classe est grande.", "alts": ["Notre salle de classe est grande."] },
    "s15-mpa-ekkalaamu": { "text": "Donnez-moi un stylo, madame.", "alts": ["Donnez-moi le stylo, madame.", "Passez-moi un stylo, madame."] },
    "s15-mpandiika-ebigambo": { "text": "J’écris les mots sur une feuille.", "alts": ["J’écris les mots sur le papier.", "J’écris des mots sur une feuille."] },
    "s15-musome-ekitabo": { "text": "Lisez le livre, tout le monde.", "alts": ["Lisez le livre.", "Lisez tous le livre."] },
    "s15-muwandiike-erinnya": { "text": "Écrivez vos noms, tout le monde.", "alts": ["Écrivez votre nom.", "Écrivez tous votre nom."] },
    "s15-muwulirize": {
      "text": "Écoutez l’enseignant, tout le monde.",
      "alts": ["Écoutez le professeur.", "Écoutez tous le maître.", "Écoutez l’enseignant."]
    },
    "s15-nsoma-olungereza": { "text": "J’étudie l’anglais et le luganda.", "alts": ["J’apprends l’anglais et le luganda."] },
    "s15-nnyagala-nnyo-okubala": { "text": "J’aime beaucoup les maths.", "alts": ["J’adore les maths.", "J’aime beaucoup les mathématiques."] },
    "s15-ssaayansi-nzibu": { "text": "Les sciences, c’est difficile.", "alts": ["Les sciences sont difficiles.", "La science, c’est dur."] },
    "s15-nnina-ekibuuzo": { "text": "J’ai une question." },
    "s15-otegeera": { "text": "Tu comprends ? Oui, je comprends.", "alts": ["Tu as compris ? Oui, j’ai compris."] },
    "s15-ddamu-mpola": { "text": "Répétez lentement, monsieur.", "alts": ["Redites-le lentement, monsieur.", "Répétez doucement, monsieur."] },
    "s15-omulimu-gwawaka": { "text": "Je fais mes devoirs.", "alts": ["Je fais les devoirs.", "Je suis en train de faire mes devoirs."] },
    "s15-ekigezo-enkya": { "text": "L’examen est demain.", "alts": ["Le contrôle est demain."] },
    "s-kalamu-nyeusi": { "text": "Mon stylo est noir." },
    "s-mwalimu-ubaoni": { "text": "L’enseignant écrit au tableau.", "alts": ["Le professeur écrit au tableau.", "La maîtresse écrit au tableau."] },
    "s-somo-hesabu": { "text": "La leçon d’aujourd’hui, c’est les maths.", "alts": ["Aujourd’hui, la leçon est sur les maths.", "Aujourd’hui, on a maths."] },
    "s-napenda-sayansi": { "text": "J’aime les sciences.", "alts": ["J’adore les sciences."] },
    "s-masomo-mengi": { "text": "Il y a beaucoup de matières !", "alts": ["Il y a beaucoup de leçons !", "Tant de matières !"] },
    "s-una-swali": { "text": "Tu as une question ?", "alts": ["Des questions ?", "Avez-vous une question ?"] },
    "s-jibu-ni-nini": { "text": "Quelle est la réponse ?", "alts": ["C’est quoi, la réponse ?"] },
    "s-kesho-mtihani": { "text": "Demain, on a un examen.", "alts": ["Nous avons un examen demain.", "Demain, nous avons un contrôle."] },
    "s-kazi-nyumbani-nyingi": { "text": "Il y a beaucoup de devoirs !", "alts": ["Tant de devoirs !", "Que de devoirs !"] },
    "s-andika-jina": { "text": "Écris ton nom.", "alts": ["Note ton nom.", "Écrivez votre nom."] },
    "s-soma-kitabu": { "text": "Lis le livre.", "alts": ["Lis un livre.", "Lisez le livre."] },
    "s-unasemaje": { "text": "Comment dit-on ça en {to} ?", "alts": ["Comment tu dis ça en {to} ?", "Comment on dit ça en {to} ?"] },
    "s-neno-gani": { "text": "Quel mot ?" },
    "s-ina-maana-gani": { "text": "Qu’est-ce que ça veut dire ?", "alts": ["Ça veut dire quoi ?", "Que signifie ce mot ?"] },
    "s-historia-ndefu": { "text": "La côte a une longue histoire." },
    "s-karne-nyingi": { "text": "Il y a de nombreux siècles.", "alts": ["Il y a bien des siècles."] },
    "s-biashara-ya-bahari": {
      "text": "Le commerce maritime était important.",
      "alts": ["Le commerce par la mer était important.", "Le commerce maritime était grand."]
    }
