    "cooking-luwombo": {
      "title": "En cuisine avec {@jjajja}",
      "summary": "{@amara} apprend à cuisiner le luwombo de poulet.",
      "lines": [
        "Aujourd’hui, nous allons cuisiner un luwombo de poulet.",
        "D’accord ! Qu’est-ce que je fais ?",
        "D’abord, coupe les oignons et les tomates.",
        "C’est fait ! Et ensuite ?",
        "Mets le poulet et la sauce dans les feuilles de bananier, et enveloppe-les bien.",
        "Puis on met la marmite sur le feu, pendant deux heures.",
        "Deux heures ? J’ai très faim !",
        "Haha ! Le repas est prêt. Mangeons !",
        "C’est délicieux ! Merci d’avoir cuisiné, Mamie."
      ],
      "questions": [
        {
          "question": "Que fait {@amara} en premier ?",
          "options": ["Elle coupe les oignons et les tomates", "Elle allume le feu", "Elle lave la marmite"]
        },
        { "question": "Combien de temps cuit le luwombo ?", "options": ["Dix minutes", "Deux heures", "Toute la nuit"] },
        { "question": "Que dit {@amara} après le repas ?", "options": ["Merci d’avoir cuisiné", "D’abord, coupe", "Je t’attends"] }
      ]
    },
