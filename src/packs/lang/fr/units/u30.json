  "stories": {
    "sw-ramadan-evening": {
      "title": "Un soir de ramadan",
      "summary": "Emma rejoint Bibi pour rompre le jeûne au coucher du soleil.",
      "lines": [
        "Mamie, tu as jeûné aujourd’hui ?",
        "Oui, depuis l’aube. Quand le soleil se couchera, nous mangerons ensemble.",
        "Qu’est-ce qu’on va manger ?",
        "Des dattes, de la bouillie et des samoussas. Tu es la bienvenue.",
        "Merci, Mamie. Que Dieu te bénisse.",
        "Amen, mon enfant."
      ],
      "questions": [
        { "question": "Quand vont-elles manger ?", "options": ["Au coucher du soleil", "À l’aube", "À midi"] },
        { "question": "Que vont-elles manger d’abord ?", "options": ["Des dattes, de la bouillie et des samoussas", "De l’ugali", "Rien"] },
        { "question": "Comment Emma dit-elle « que Dieu te bénisse » ?", "options": ["Que Dieu te bénisse", "Si Dieu le veut", "Amen"] }
      ]
    }
