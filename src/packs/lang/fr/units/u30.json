    "s30-paasika": { "text": "Joyeuses Pâques !" },
    "s30-iddi": { "text": "Bonne fête de l’Aïd !", "alts": ["Aïd Moubarak !"] },
    "s30-okusiiba": { "text": "Pendant le ramadan, nous jeûnons.", "alts": ["Nous jeûnons pendant le ramadan.", "Pendant le ramadan, on jeûne."] },
