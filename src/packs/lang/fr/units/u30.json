  "sentences": {
    "s30-tusaba-katonda": { "text": "Nous prions Dieu tous les jours.", "alts": ["Nous prions tous les jours.", "On prie Dieu chaque jour."] },
    "s30-ssabbiiti-ekkanisa": { "text": "Le dimanche, je vais à l’église.", "alts": ["Je vais à l’église le dimanche.", "Dimanche, je vais à l’église."] },
    "s30-lwakutaano-omuzigiti": { "text": "Le vendredi, il va à la mosquée.", "alts": ["Le vendredi, elle va à la mosquée.", "Vendredi, il va à la mosquée."] },
    "s30-nsaba-amazzi": { "text": "Je peux avoir de l’eau, madame ?", "alts": ["De l’eau, s’il vous plaît, madame.", "Puis-je avoir de l’eau, madame ?"] },
