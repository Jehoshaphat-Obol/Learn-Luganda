    "s30-katonda-akuwe-omukisa": { "text": "Que Dieu te bénisse !", "alts": ["Dieu te bénisse !", "Que Dieu vous bénisse !"] },
    "s30-amiina": { "text": "Amen." },
    "s-sikukuu-kesho": { "text": "Demain, c’est férié.", "alts": ["Demain est un jour férié.", "Demain, c’est jour de fête."] },
    "s-idi": { "text": "Nous fêterons l’Aïd ensemble.", "alts": ["On fêtera l’Aïd ensemble."] },
    "s-krismasi": { "text": "À Noël, nous allons au village.", "alts": ["Pour Noël, on va au village."] },
    "s-dini": { "text": "Il y a beaucoup de religions en Afrique de l’Est." },
    "s-kusali-msikitini": { "text": "Grand-père prie à la mosquée.", "alts": ["Papi prie à la mosquée."] },
    "s-kusali-kanisani": { "text": "Le dimanche, nous prions à l’église.", "alts": ["Le dimanche, on prie à l’église."] },
