{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jehoshaphat-obol.github.io/Learn-Luganda/schema/course.schema.json",
  "title": "Course pack: course.json",
  "description": "The top of a course pack in src/packs/courses/<from>-<to>/: which languages it pairs and how its units group into sections. Each unit lives in units/<unitId>.json.",
  "type": "object",
  "required": [
    "formatVersion",
    "id",
    "version",
    "from",
    "to",
    "status",
    "title",
    "sections"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "const": 1,
      "description": "Version of the pack file format. The app upgrades older formats when it loads them."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z]{2,3}-[a-z]{2,3}$",
      "description": "<from>-<to>; must match the folder name."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Content version. Raise it whenever an id is renamed or removed, and add a migration so saved progress follows."
    },
    "from": {
      "type": "string",
      "description": "Base language: the one the learner already reads. A code from languages.json."
    },
    "to": {
      "type": "string",
      "description": "Target language: the one being taught. A code from languages.json."
    },
    "status": {
      "enum": [
        "draft",
        "reviewed"
      ],
      "description": "draft until a fluent speaker has reviewed the whole course."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "In the base language, e.g. \"Luganda for English speakers\"."
    },
    "description": {
      "type": "string",
      "description": "One or two sentences, in the base language, about the target language and where it is spoken."
    },
    "notes": {
      "type": "string",
      "description": "For authors and reviewers; never shown to learners."
    },
    "settings": {
      "$ref": "settings.schema.json",
      "description": "How the course teaches: lesson recipe, exercise options, test sizes and pass marks, answer checking, stories."
    },
    "cast": {
      "type": "object",
      "description": "The course's characters, by id. Dialogue speakers, story casts and unit characters must be listed here.",
      "propertyNames": {
        "pattern": "^[a-z0-9-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/castMember"
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "description": "Stages of the course, in order. Units appear in the order listed here.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "units"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "type": "string",
            "description": "e.g. Beginner, Intermediate."
          },
          "description": {
            "type": "string"
          },
          "units": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "description": "Unit ids. A listed unit with no file yet is skipped, so content can land a few units at a time."
          }
        }
      }
    },
    "migrations": {
      "type": "array",
      "description": "One step per content version that renamed or removed ids, oldest first. When a learner opens a newer pack, every step above their saved version is applied to their progress. Ids the pack no longer has are archived, never deleted.",
      "items": {
        "type": "object",
        "required": [
          "version"
        ],
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 2,
            "description": "The content version this step brings progress up to."
          },
          "note": {
            "type": "string",
            "description": "What changed, for authors."
          },
          "rename": {
            "type": "object",
            "additionalProperties": false,
            "description": "Old id → new id. Several old ids to one new id merge their progress; one old id to a list splits it (each new id gets a copy).",
            "properties": {
              "words": {
                "type": "object",
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-z0-9-]+$"
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9-]+$"
                      }
                    }
                  ]
                }
              },
              "lessons": {
                "type": "object",
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-z0-9-]+$"
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9-]+$"
                      }
                    }
                  ]
                }
              },
              "stories": {
                "type": "object",
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-z0-9-]+$"
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9-]+$"
                      }
                    }
                  ]
                }
              },
              "units": {
                "type": "object",
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-z0-9-]+$"
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9-]+$"
                      }
                    }
                  ]
                }
              },
              "sections": {
                "type": "object",
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-z0-9-]+$"
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9-]+$"
                      }
                    }
                  ]
                }
              }
            }
          },
          "remove": {
            "type": "object",
            "additionalProperties": false,
            "description": "Ids whose progress moves to the archive.",
            "properties": {
              "words": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "lessons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "stories": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "units": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "sections": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "cheers": {
      "type": "array",
      "description": "Short words of praise in the target language (\"Kale!\"). The lesson mixes them in with the UI pack's praise after a right answer.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "phrases": {
      "type": "object",
      "description": "Set phrases in the target language that celebrations drop into UI pack text.",
      "additionalProperties": false,
      "properties": {
        "congrats": {
          "type": "string",
          "description": "Well done, on finishing the course (\"Wayita bulungi\")."
        },
        "thanks": {
          "type": "string",
          "description": "A warm thank-you after a checkpoint (\"Weebale nnyo!\")."
        }
      }
    },
    "landing": {
      "type": "object",
      "description": "What the landing page, onboarding and About page say about this course, in the base language. Text may use **bold**, _italic_ and [links](#/path). Target-language words are written as the learner will see them.",
      "required": [
        "hello",
        "thanks",
        "place",
        "words",
        "why",
        "sample",
        "start",
        "audience",
        "first"
      ],
      "additionalProperties": false,
      "properties": {
        "hello": {
          "type": "string",
          "minLength": 1,
          "description": "A greeting in the target language, e.g. \"Oli otya?\"."
        },
        "thanks": {
          "type": "string",
          "minLength": 1,
          "description": "\"Thank you\" in the target language."
        },
        "place": {
          "type": "string",
          "minLength": 1,
          "description": "Where the language is spoken, for \"Travel to {place}\"."
        },
        "word": {
          "type": "string",
          "description": "A dictionary-style caption under the hero, e.g. \"okuyiga — v. to learn\"."
        },
        "words": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "string",
                "minLength": 1
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "description": "Target word and meaning pairs for the scrolling ticker."
        },
        "why": {
          "type": "object",
          "required": [
            "title",
            "text",
            "cards"
          ],
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "cards": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "required": [
                  "title",
                  "text"
                ],
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "sample": {
          "type": "object",
          "required": [
            "prompt",
            "options",
            "answer",
            "explain"
          ],
          "additionalProperties": false,
          "description": "The landing page's playable question.",
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 1
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "answer": {
              "type": "string",
              "minLength": 1
            },
            "explain": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "start": {
          "type": "object",
          "required": [
            "word"
          ],
          "additionalProperties": false,
          "properties": {
            "word": {
              "type": "string",
              "minLength": 1,
              "description": "\"Start!\" in the target language."
            },
            "caption": {
              "type": "string"
            }
          }
        },
        "farewell": {
          "type": "string",
          "description": "A closing line for the footer."
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "description": "FAQ answer: who the course is for."
        },
        "first": {
          "type": "string",
          "minLength": 1,
          "description": "FAQ answer: what the first units teach."
        }
      }
    }
  },
  "$defs": {
    "castMember": {
      "type": "object",
      "required": [
        "name",
        "look"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "description": "One line, in the base language, shown on the landing page."
        },
        "look": {
          "description": "Either the id of an illustrated look in src/illustrations/characters.js (nakato, mukasa, jjajja, ssali, amara, emma), or a new look built from the same parts.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/look"
            }
          ]
        },
        "voice": {
          "$ref": "settings.schema.json#/$defs/voice",
          "description": "This person's voice in dialogues and stories, over the course's default (settings.speech.voice)."
        }
      }
    },
    "look": {
      "type": "object",
      "required": [
        "skin",
        "shade",
        "hair",
        "hairColor",
        "top",
        "card",
        "backdrop",
        "texture"
      ],
      "additionalProperties": false,
      "properties": {
        "skin": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "shade": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Shaded half of the face, a little darker than skin."
        },
        "hair": {
          "enum": [
            "puffs",
            "short",
            "braids",
            "bob",
            "cap",
            "headwrap"
          ]
        },
        "hairColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "top": {
          "$ref": "#/$defs/fill"
        },
        "card": {
          "$ref": "#/$defs/fill"
        },
        "backdrop": {
          "enum": [
            "circle",
            "quarter",
            "half",
            "arch"
          ]
        },
        "backdropColor": {
          "$ref": "#/$defs/fill"
        },
        "texture": {
          "enum": [
            "dots",
            "grid",
            "hatch"
          ]
        },
        "extras": {
          "type": "array",
          "items": {
            "enum": [
              "earrings",
              "glasses",
              "gomesi",
              "beard"
            ]
          }
        }
      }
    },
    "fill": {
      "enum": [
        "f-blush",
        "f-cream",
        "f-grey",
        "f-grey-light",
        "f-ink",
        "f-ink-soft",
        "f-lavender",
        "f-paper",
        "f-paper-light",
        "f-sage",
        "f-verm",
        "f-verm-deep",
        "f-white"
      ],
      "description": "Theme fill colours from src/illustrations/illustrations.css."
    }
  }
}
