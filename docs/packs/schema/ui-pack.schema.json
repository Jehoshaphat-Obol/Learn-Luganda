{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jehoshaphat-obol.github.io/Learn-Luganda/schema/ui-pack.schema.json",
  "title": "UI pack",
  "description": "Every interface string of the app in one language. Saved as src/packs/ui/<code>.json. Keys and {placeholders} must match the English pack; keys left out fall back to English.",
  "type": "object",
  "required": ["meta", "strings"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "meta": {
      "type": "object",
      "required": ["code", "status"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$", "description": "BCP 47 tag; must match the file name and an entry in src/packs/languages.json." },
        "status": { "enum": ["draft", "reviewed"], "description": "draft until a fluent speaker has reviewed every string." },
        "notes": { "type": "string" }
      }
    },
    "strings": { "$ref": "#/$defs/group" }
  },
  "$defs": {
    "group": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
      "additionalProperties": { "anyOf": [{ "type": "string" }, { "$ref": "#/$defs/plural" }, { "$ref": "#/$defs/group" }] }
    },
    "plural": {
      "description": "Plural forms chosen by Intl.PluralRules from the {count} parameter. 'other' is required.",
      "type": "object",
      "required": ["other"],
      "additionalProperties": false,
      "properties": {
        "zero": { "type": "string" },
        "one": { "type": "string" },
        "two": { "type": "string" },
        "few": { "type": "string" },
        "many": { "type": "string" },
        "other": { "type": "string" }
      }
    }
  }
}
