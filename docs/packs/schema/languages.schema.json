{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jehoshaphat-obol.github.io/Learn-Luganda/schema/languages.schema.json",
  "title": "Language registry",
  "description": "src/packs/languages.json: every language the app can name and greet in.",
  "type": "object",
  "required": [
    "languages"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "name",
          "nativeName",
          "greeting",
          "dir"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The language's name in English."
          },
          "nativeName": {
            "type": "string",
            "minLength": 1,
            "description": "The language's name in itself."
          },
          "greeting": {
            "type": "string",
            "minLength": 1,
            "description": "A short everyday hello, shown on the language picker."
          },
          "flag": {
            "type": "string",
            "pattern": "^[a-z]{2}$",
            "description": "ISO 3166-1 alpha-2 code (lowercase) of the country whose flag is shown beside the language's name. Leave out when no one country fits."
          },
          "dir": {
            "enum": [
              "ltr",
              "rtl"
            ]
          }
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
