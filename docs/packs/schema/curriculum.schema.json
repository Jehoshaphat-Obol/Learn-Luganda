{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jehoshaphat-obol.github.io/Learn-Luganda/schema/curriculum.schema.json",
  "title": "Shared catalog: the curriculum",
  "description": "src/packs/curriculum/course.json. The one course structure every language fills (#185): sections, cast and the version that saved progress is kept in step with. Text lives in src/packs/lang/<code>/.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "version",
    "sections"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "const": 2
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "migrations": {
      "$ref": "course.schema.json#/properties/migrations"
    },
    "culture": {
      "type": "string",
      "description": "The language whose culture `cast` names and `places` are (lg). Courses teaching it use them as they are."
    },
    "cast": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "look"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The default name, used by languages whose lang pack has no culture for this cast member. Text writes {@id} for it."
          },
          "look": {
            "$ref": "course.schema.json#/$defs/castMember/properties/look"
          },
          "voice": {
            "$ref": "settings.schema.json#/$defs/voice"
          },
          "short": {
            "type": "string",
            "minLength": 1,
            "description": "What text calls them ({@id}) when it isn't the full name ({@id.name}), e.g. Jjajja for Jjajja Nalwoga."
          }
        }
      }
    },
    "places": {
      "type": "object",
      "description": "Culture slots for places: the default for each {@id} in lang text (a home city, a hometown, a trip away...). A language's `culture.places` replaces them in courses that teach it.",
      "propertyNames": {
        "pattern": "^[a-z0-9-]+$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "units"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "units": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          }
        }
      }
    }
  }
}
